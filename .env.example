# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=government_fms
DATABASE_URL=mysql://root:@localhost:3306/government_fms
# Host port for the Docker database (docker compose up -d). To use it, also set DATABASE_PORT=3307
DATABASE_DOCKER_PORT=3307

# Authentication
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Application
NODE_ENV=development
PORT=4321
PUBLIC_URL=http://localhost:4321

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./storage/uploads
