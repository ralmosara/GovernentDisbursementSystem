---
import '../styles/global.css';
import 'primeicons/primeicons.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Philippine Government Financial Management System',
  description = 'Complete financial management system for Philippine government agencies'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C66E4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Apply the saved theme before first paint so dark mode doesn't flash light -->
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          theme = localStorage.getItem('fms.theme') || 'light';
        } catch (e) {}
        if (theme !== 'dark' && theme !== 'system') theme = 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
