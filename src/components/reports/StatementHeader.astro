---
// Centred heading of a financial statement: agency, statement name, fund and period.
interface Props {
  agencyName?: string;
  title: string;
  fund: string;
  period: string;
}

const { agencyName, title, fund, period } = Astro.props;
---

<header class="px-6 pt-6 pb-4 text-center border-b border-gray-200">
  {agencyName && <p class="font-semibold text-gray-800">{agencyName}</p>}
  <p class="text-lg font-semibold text-gray-800">{title.toUpperCase()}</p>
  <p class="text-sm text-gray-600">{fund}</p>
  <p class="text-sm text-gray-600">{period}</p>
  <p class="text-xs text-gray-500 mt-1">(In Philippine Peso)</p>
</header>
