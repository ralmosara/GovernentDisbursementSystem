---
// ADS page header: breadcrumbs, title, optional description and an actions slot.
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<header class="mb-6">
  {breadcrumbs.length > 0 && (
    <nav aria-label="Breadcrumb" class="mb-2">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-600">
        {breadcrumbs.map((crumb, index) => (
          <li class="flex items-center gap-1">
            {index > 0 && <span class="text-gray-400" aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:underline hover:text-gray-800">{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="page-title break-words">{title}</h1>
      {description && <p class="page-description">{description}</p>}
      <slot name="meta" />
    </div>
    {hasActions && (
      <div class="page-actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</header>
