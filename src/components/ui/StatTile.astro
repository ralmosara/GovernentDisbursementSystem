---
// A single headline number. `href` makes the tile a link to the underlying list.
interface Props {
  label: string;
  value: string | number;
  help?: string;
  href?: string;
  /** Optional icon shown beside the label, e.g. pi-clock */
  icon?: string;
  title?: string;
}

const { label, value, help, href, icon, title } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class="card block p-4 min-w-0" title={title}>
  <p class="flex items-center gap-1.5 text-xs font-semibold text-gray-600">
    {icon && <i class={`pi ${icon} text-[11px] text-gray-500`} aria-hidden="true"></i>}
    {label}
  </p>
  <p class="mt-1 text-2xl font-semibold text-gray-800 tabular-nums truncate">{value}</p>
  {help && <p class="mt-0.5 text-xs text-gray-500">{help}</p>}
</Tag>
