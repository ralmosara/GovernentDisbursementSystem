---
// Top navigation. Left: menu toggle + brand. Centre: "Go to" search across every
// page and create action (Ctrl+K or /). Right: Create menu, approvals, help, profile.
import { homeItems, visibleNavSections, createActions } from '../../lib/navigation';
import { workQueueService } from '../../lib/services/work-queue.service';

const user = Astro.locals.user;
const displayName = user ? `${user.firstName} ${user.lastName}` : 'Guest';
const userInitials = user ? `${user.firstName[0]}${user.lastName[0]}` : 'G';
const isAdmin = Boolean(user?.roles?.includes('administrator'));

// Items waiting on this user — the same queue the approvals page and dashboard show
const attentionCount = user ? await workQueueService.getCount({ id: user.id, roles: user.roles ?? [] }) : 0;
const attentionLabel = attentionCount
  ? `${attentionCount} item${attentionCount === 1 ? '' : 's'} waiting for you`
  : 'Nothing waiting for you';

// Flattened index for the search palette
const searchIndex = [
  ...createActions.map(action => ({
    label: `Create ${action.label.toLowerCase()}`,
    hint: action.description,
    href: action.href,
    icon: 'pi-plus',
    group: 'Create',
  })),
  ...homeItems.map(item => ({ label: item.label, hint: '', href: item.href, icon: item.icon, group: 'Go to' })),
  ...visibleNavSections(isAdmin).flatMap(section =>
    section.items.map(item => ({ label: item.label, hint: section.title, href: item.href, icon: item.icon, group: 'Go to' }))
  ),
];
---

<header
  class="relative z-30 flex items-center gap-2 h-topnav px-3 sm:px-4 bg-surface border-b border-gray-200 shrink-0"
>
  <!-- Left: menu + brand -->
  <div class="flex items-center gap-1 shrink-0">
    <button
      type="button"
      data-sidebar-toggle
      class="nav-icon-button lg:hidden"
      aria-label="Open navigation"
      aria-controls="app-sidebar"
      aria-expanded="false"
    >
      <i class="pi pi-bars" aria-hidden="true"></i>
    </button>
    <a href="/dashboard" class="flex items-center gap-2 px-2 py-1 rounded hover:bg-gray-100" aria-label="Gov FMS home">
      <span class="flex items-center justify-center w-7 h-7 rounded-md bg-primary-600 text-white" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 1.5 14 4.5v1H2v-1L8 1.5Z" fill="currentColor"/>
          <path d="M3.5 7h2v5h-2V7Zm3.5 0h2v5H7V7Zm3.5 0h2v5h-2V7Z" fill="currentColor" opacity=".85"/>
          <path d="M2 13h12v1.5H2V13Z" fill="currentColor"/>
        </svg>
      </span>
      <span class="hidden sm:block font-semibold text-gray-800 whitespace-nowrap">Gov FMS</span>
    </a>
  </div>

  <!-- Centre: search -->
  <div class="flex-1 flex justify-center min-w-0">
    <button
      type="button"
      id="search-trigger"
      class="hidden md:flex items-center gap-2 w-full max-w-md h-8 px-2.5 rounded border border-gray-400/60 bg-surface text-gray-500 hover:bg-surface-sunken transition-colors"
      aria-haspopup="dialog"
      aria-controls="search-dialog"
    >
      <i class="pi pi-search text-sm" aria-hidden="true"></i>
      <span class="flex-1 text-left text-sm">Search pages and actions</span>
      <span class="kbd">Ctrl K</span>
    </button>
  </div>

  <!-- Right: actions -->
  <div class="flex items-center gap-1 shrink-0">
    <button type="button" id="search-trigger-mobile" class="nav-icon-button md:hidden" aria-label="Search">
      <i class="pi pi-search" aria-hidden="true"></i>
    </button>

    <div class="relative" data-menu>
      <button
        type="button"
        class="btn btn-primary"
        data-menu-button
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="create-menu"
      >
        <i class="pi pi-plus" aria-hidden="true"></i>
        <span class="hidden sm:inline">Create</span>
      </button>
      <div
        id="create-menu"
        role="menu"
        data-menu-panel
        class="hidden absolute right-0 mt-1 w-80 py-2 bg-surface-overlay rounded shadow-lg"
      >
        <p class="px-4 pt-1 pb-2 text-xs font-semibold text-gray-500">What do you need to do?</p>
        {createActions.map(action => (
          <a href={action.href} role="menuitem" class="menu-item !items-start">
            <span class="mt-0.5 flex items-center justify-center w-7 h-7 rounded bg-primary-100 shrink-0">
              <i class={`pi ${action.icon} !text-primary-600 text-sm`} aria-hidden="true"></i>
            </span>
            <span class="min-w-0">
              <span class="block font-medium">{action.label}</span>
              <span class="block text-xs text-gray-500">{action.description}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <a href="/approvals" class="nav-icon-button relative" aria-label={`Approvals: ${attentionLabel}`} title={attentionLabel}>
      <i class="pi pi-bell" aria-hidden="true"></i>
      {attentionCount > 0 && (
        <span class="nav-badge" aria-hidden="true">{attentionCount > 99 ? '99+' : attentionCount}</span>
      )}
    </a>

    <a href="/reports" class="nav-icon-button hidden sm:inline-flex" aria-label="Reports" title="Reports">
      <i class="pi pi-chart-bar" aria-hidden="true"></i>
    </a>

    {isAdmin && (
      <a href="/admin/settings" class="nav-icon-button hidden sm:inline-flex" aria-label="System settings" title="System settings">
        <i class="pi pi-cog" aria-hidden="true"></i>
      </a>
    )}

    <div class="relative ml-1" data-menu>
      <button
        type="button"
        class="flex items-center rounded-full p-0.5 hover:bg-gray-100"
        data-menu-button
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="user-menu"
        aria-label={`Account: ${displayName}`}
      >
        <span class="flex items-center justify-center w-7 h-7 rounded-full bg-[#6E5DC6] text-white text-xs font-semibold">
          {userInitials}
        </span>
      </button>
      <div
        id="user-menu"
        role="menu"
        data-menu-panel
        class="hidden absolute right-0 mt-1 w-64 py-2 bg-surface-overlay rounded shadow-lg"
      >
        <div class="flex items-center gap-3 px-4 pt-1 pb-3 border-b border-gray-200 mb-2">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-[#6E5DC6] text-white text-sm font-semibold shrink-0">
            {userInitials}
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-gray-800 truncate">{displayName}</span>
            <span class="block text-xs text-gray-500 truncate">@{user?.username}</span>
          </span>
        </div>
        <a href="/profile" role="menuitem" class="menu-item">
          <i class="pi pi-user" aria-hidden="true"></i>
          Profile
        </a>
        {isAdmin && (
          <a href="/admin/settings" role="menuitem" class="menu-item">
            <i class="pi pi-cog" aria-hidden="true"></i>
            System settings
          </a>
        )}
        <hr class="my-2 border-gray-200" />
        <p class="px-4 pb-1 text-xs font-semibold text-gray-500" id="theme-label">Theme</p>
        <div role="group" aria-labelledby="theme-label">
          {[
            { value: 'light', label: 'Light', icon: 'pi-sun' },
            { value: 'dark', label: 'Dark', icon: 'pi-moon' },
            { value: 'system', label: 'Match system', icon: 'pi-desktop' },
          ].map(option => (
            <button type="button" role="menuitemradio" aria-checked="false" class="menu-item" data-theme-option={option.value}>
              <i class={`pi ${option.icon}`} aria-hidden="true"></i>
              <span class="flex-1">{option.label}</span>
              <i class="pi pi-check !text-primary-600 invisible" data-theme-check aria-hidden="true"></i>
            </button>
          ))}
        </div>
        <hr class="my-2 border-gray-200" />
        <a href="/logout" role="menuitem" class="menu-item">
          <i class="pi pi-sign-out" aria-hidden="true"></i>
          Log out
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Search / "Go to" palette -->
<div id="search-dialog" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="Search pages and actions">
  <div class="absolute inset-0 bg-gray-950/50" data-search-close></div>
  <div class="relative mx-auto mt-[10vh] w-[calc(100%-2rem)] max-w-xl bg-surface-overlay rounded-lg shadow-2xl overflow-hidden">
    <div class="flex items-center gap-2 px-4 border-b border-gray-200">
      <i class="pi pi-search text-gray-500" aria-hidden="true"></i>
      <input
        id="search-input"
        type="text"
        class="flex-1 h-12 !border-0 !ring-0 !shadow-none px-0 text-base focus:outline-none"
        placeholder="Where do you want to go?"
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <span class="kbd">Esc</span>
    </div>
    <ul id="search-results" role="listbox" class="max-h-[60vh] overflow-y-auto scrollbar-thin py-2"></ul>
    <div class="flex items-center gap-4 px-4 py-2 border-t border-gray-200 bg-gray-50 text-xs text-gray-500">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> to navigate</span>
      <span><span class="kbd">Enter</span> to open</span>
    </div>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

<script>
  // ---------- Dropdown menus (Create, profile) ----------
  const menus = Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));

  function closeMenus(except?: HTMLElement) {
    menus.forEach(menu => {
      if (menu === except) return;
      menu.querySelector('[data-menu-panel]')?.classList.add('hidden');
      menu.querySelector('[data-menu-button]')?.setAttribute('aria-expanded', 'false');
    });
  }

  menus.forEach(menu => {
    const button = menu.querySelector<HTMLElement>('[data-menu-button]')!;
    const panel = menu.querySelector<HTMLElement>('[data-menu-panel]')!;
    button.addEventListener('click', () => {
      const open = panel.classList.contains('hidden');
      closeMenus(menu);
      panel.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      if (open) panel.querySelector<HTMLElement>('[role="menuitem"], [role="menuitemradio"]')?.focus();
    });
    panel.addEventListener('keydown', event => {
      const items = Array.from(panel.querySelectorAll<HTMLElement>('[role="menuitem"], [role="menuitemradio"]'));
      const index = items.indexOf(document.activeElement as HTMLElement);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        items[(index + 1) % items.length]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        items[(index - 1 + items.length) % items.length]?.focus();
      } else if (event.key === 'Escape') {
        closeMenus();
        button.focus();
      }
    });
  });

  document.addEventListener('click', event => {
    const target = event.target as Node;
    if (!menus.some(menu => menu.contains(target))) closeMenus();
  });

  // ---------- Search palette ----------
  interface SearchEntry {
    label: string;
    hint: string;
    href: string;
    icon: string;
    group: string;
  }

  const dialog = document.getElementById('search-dialog')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;
  const entries: SearchEntry[] = JSON.parse(document.getElementById('search-index')?.textContent || '[]');

  // ---------- Recently visited pages (this browser only) ----------
  const RECENT_KEY = 'fms.recent';
  function readRecent(): { href: string; label: string }[] {
    try {
      const value = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(value) ? value : [];
    } catch {
      return [];
    }
  }

  (function recordVisit() {
    const href = window.location.pathname + window.location.search;
    const label = document.title.replace(/\s*[-–|]\s*Philippine Government FMS\s*$/i, '').trim() || href;
    const recent = [{ href, label }, ...readRecent().filter(item => item.href !== href)].slice(0, 8);
    try {
      localStorage.setItem(RECENT_KEY, JSON.stringify(recent));
    } catch {
      // Storage unavailable; recent pages simply won't be remembered
    }
  })();

  function recentEntries(): SearchEntry[] {
    const here = window.location.pathname + window.location.search;
    return readRecent()
      .filter(item => item.href !== here)
      .slice(0, 5)
      .map(item => ({ label: item.label, hint: '', href: item.href, icon: 'pi-history', group: 'Recent' }));
  }
  let matches: SearchEntry[] = [];
  let activeIndex = 0;
  let lastFocus: HTMLElement | null = null;

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
  }

  function render() {
    const query = input.value.trim().toLowerCase();
    const terms = query.split(/\s+/).filter(Boolean);
    if (terms.length === 0) {
      matches = [...recentEntries(), ...entries];
    } else {
      matches = entries.filter(entry => {
        const haystack = `${entry.label} ${entry.hint} ${entry.group}`.toLowerCase();
        return terms.every(term => haystack.includes(term));
      });
      // Search records too: voucher numbers, payees and particulars
      matches.push({
        label: `Search vouchers for “${input.value.trim()}”`,
        hint: 'DV no., payee or particulars',
        href: `/disbursements?search=${encodeURIComponent(input.value.trim())}`,
        icon: 'pi-search',
        group: 'Search records',
      });
    }
    activeIndex = Math.min(activeIndex, Math.max(matches.length - 1, 0));

    if (matches.length === 0 && terms.length === 0) {
      results.innerHTML = `<li class="px-4 py-6 text-center text-sm text-gray-500">No pages or actions match “${escapeHtml(input.value)}”</li>`;
      input.removeAttribute('aria-activedescendant');
      return;
    }

    let html = '';
    let group = '';
    matches.forEach((entry, i) => {
      if (entry.group !== group) {
        group = entry.group;
        html += `<li role="presentation" class="px-4 pt-2 pb-1 text-xs font-semibold text-gray-500">${escapeHtml(group)}</li>`;
      }
      html += `<li id="search-option-${i}" role="option" aria-selected="${i === activeIndex}" data-index="${i}"
        class="menu-item cursor-pointer" data-active="${i === activeIndex}">
        <i class="pi ${escapeHtml(entry.icon)}" aria-hidden="true"></i>
        <span class="flex-1 min-w-0 truncate">${escapeHtml(entry.label)}</span>
        ${entry.hint ? `<span class="text-xs text-gray-500 truncate max-w-[45%]">${escapeHtml(entry.hint)}</span>` : ''}
      </li>`;
    });
    results.innerHTML = html;
    input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
    document.getElementById(`search-option-${activeIndex}`)?.scrollIntoView({ block: 'nearest' });
  }

  function openSearch() {
    lastFocus = document.activeElement as HTMLElement;
    closeMenus();
    dialog.classList.remove('hidden');
    input.value = '';
    activeIndex = 0;
    render();
    input.focus();
  }

  function closeSearch() {
    dialog.classList.add('hidden');
    lastFocus?.focus();
  }

  document.getElementById('search-trigger')?.addEventListener('click', openSearch);
  document.getElementById('search-trigger-mobile')?.addEventListener('click', openSearch);
  dialog.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);

  input.addEventListener('input', () => {
    activeIndex = 0;
    render();
  });

  input.addEventListener('keydown', event => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % Math.max(matches.length, 1);
      render();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      activeIndex = (activeIndex - 1 + matches.length) % Math.max(matches.length, 1);
      render();
    } else if (event.key === 'Enter' && matches[activeIndex]) {
      event.preventDefault();
      window.location.href = matches[activeIndex].href;
    } else if (event.key === 'Escape') {
      closeSearch();
    }
  });

  results.addEventListener('click', event => {
    const option = (event.target as HTMLElement).closest<HTMLElement>('[data-index]');
    if (option) window.location.href = matches[Number(option.dataset.index)].href;
  });

  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    const typing = target.closest('input, textarea, select, [contenteditable="true"]');
    if ((event.key === 'k' && (event.ctrlKey || event.metaKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      if (dialog.classList.contains('hidden')) openSearch();
    } else if (event.key === 'Escape') {
      closeMenus();
    }
  });
</script>

<script>
  // ---------- Theme ----------
  const THEME_KEY = 'fms.theme';
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    themeButtons.forEach(button => {
      const selected = button.dataset.themeOption === theme;
      button.setAttribute('aria-checked', String(selected));
      button.querySelector('[data-theme-check]')?.classList.toggle('invisible', !selected);
    });
  }

  applyTheme(document.documentElement.getAttribute('data-theme') || 'light');

  themeButtons.forEach(button =>
    button.addEventListener('click', () => {
      const theme = button.dataset.themeOption!;
      applyTheme(theme);
      try {
        localStorage.setItem(THEME_KEY, theme);
      } catch {
        // Storage unavailable; the choice lasts for this page only
      }
    })
  );
</script>
