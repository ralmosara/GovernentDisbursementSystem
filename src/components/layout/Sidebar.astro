---
// Side navigation. Groups are native <details> so they work without JS; the group
// holding the current page opens automatically and the rest remember their state.
// Below `lg` it becomes an off-canvas drawer opened from the top nav's menu button.
import { homeItems, visibleNavSections, findActiveHref } from '../../lib/navigation';

const user = Astro.locals.user;
const isAdmin = Boolean(user?.roles?.includes('administrator'));
const sections = visibleNavSections(isAdmin);

const allHrefs = [...homeItems, ...sections.flatMap(section => section.items)].map(item => item.href);
const activeHref = findActiveHref(Astro.url.pathname, allHrefs);
const activeSectionId = sections.find(section => section.items.some(item => item.href === activeHref))?.id;
---

<!-- Backdrop for the mobile drawer -->
<div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-gray-950/50 hidden lg:hidden" aria-hidden="true"></div>

<aside
  id="app-sidebar"
  class="fixed left-0 bottom-0 top-0 lg:top-auto z-40 lg:z-auto flex flex-col shrink-0 bg-surface border-r border-gray-200 -translate-x-full transition-transform duration-200 lg:static lg:translate-x-0 lg:h-full"
  style="width: var(--ds-sidenav-width);"
  aria-label="Main navigation"
>
  <!-- Drawer header (mobile only; the top nav carries the brand on desktop) -->
  <div class="flex items-center justify-between px-4 h-topnav border-b border-gray-200 lg:hidden">
    <span class="font-semibold text-gray-800">Gov FMS</span>
    <button type="button" id="sidebar-close" class="nav-icon-button" aria-label="Close navigation">
      <i class="pi pi-times" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto scrollbar-thin px-3 py-4">
    <ul class="space-y-0.5">
      {homeItems.map(item => (
        <li>
          <a href={item.href} class="side-nav-item" aria-current={item.href === activeHref ? 'page' : undefined}>
            <i class={`pi ${item.icon}`} aria-hidden="true"></i>
            <span class="truncate">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6 mb-1 px-2 text-xs font-semibold text-gray-500">Workspaces</p>

    <ul class="space-y-0.5">
      {sections.map(section => (
        <li>
          <details
            class="nav-group group"
            data-section={section.id}
            data-active={section.id === activeSectionId ? 'true' : undefined}
            open={section.id === activeSectionId}
          >
            <summary class="side-nav-item cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <i class={`pi ${section.icon}`} aria-hidden="true"></i>
              <span class="flex-1 truncate">{section.title}</span>
              <i class="pi pi-chevron-right !text-[10px] transition-transform group-open:rotate-90" aria-hidden="true"></i>
            </summary>
            <ul class="mt-0.5 mb-1 ml-[1.375rem] pl-2 border-l border-gray-200 space-y-0.5">
              {section.items.map(item => (
                <li>
                  <a href={item.href} class="side-nav-item !gap-2 !font-normal" aria-current={item.href === activeHref ? 'page' : undefined}>
                    <span class="truncate">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </nav>

  <div class="px-5 py-3 border-t border-gray-200">
    <p class="text-xs text-gray-500">&copy; {new Date().getFullYear()} Philippine Government</p>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('app-sidebar')!;
  const backdrop = document.getElementById('sidebar-backdrop')!;
  const closeButton = document.getElementById('sidebar-close');
  const STORAGE_KEY = 'fms.nav.open';

  function setSidebarOpen(open: boolean) {
    sidebar.classList.toggle('-translate-x-full', !open);
    backdrop.classList.toggle('hidden', !open);
    document.querySelectorAll('[data-sidebar-toggle]').forEach(btn => btn.setAttribute('aria-expanded', String(open)));
    if (open) {
      sidebar.querySelector<HTMLElement>('a[aria-current="page"], a')?.focus();
    }
  }

  document.querySelectorAll('[data-sidebar-toggle]').forEach(btn =>
    btn.addEventListener('click', () => setSidebarOpen(sidebar.classList.contains('-translate-x-full')))
  );
  closeButton?.addEventListener('click', () => setSidebarOpen(false));
  backdrop.addEventListener('click', () => setSidebarOpen(false));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !sidebar.classList.contains('-translate-x-full') && window.innerWidth < 1024) {
      setSidebarOpen(false);
      document.querySelector<HTMLElement>('[data-sidebar-toggle]')?.focus();
    }
  });

  // Restore groups the user left open; the active group is always open
  let openGroups: string[] = [];
  try {
    openGroups = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  } catch {
    openGroups = [];
  }

  const groups = sidebar.querySelectorAll<HTMLDetailsElement>('details[data-section]');
  groups.forEach(group => {
    if (openGroups.includes(group.dataset.section!)) group.open = true;
    group.addEventListener('toggle', () => {
      const open = Array.from(groups).filter(g => g.open).map(g => g.dataset.section!);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(open));
      } catch {
        // Storage unavailable (private mode); groups simply won't be remembered
      }
    });
  });

  // Keep the active link visible in a long menu
  sidebar.querySelector('a[aria-current="page"]')?.scrollIntoView({ block: 'nearest' });
</script>
