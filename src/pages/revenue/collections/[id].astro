---
import MainLayout from '../../../layouts/MainLayout.astro';
import { revenueService } from '../../../lib/services/revenue.service';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const id = parseInt(Astro.params.id as string);
let collection: Awaited<ReturnType<typeof revenueService.getCollectionById>> | null = null;
try {
  collection = id ? await revenueService.getCollectionById(id) : null;
} catch {
  collection = null;
}

if (!collection) {
  return Astro.redirect('/revenue/collections');
}

const peso = (v: unknown) =>
  `₱${(Number(v) || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const formatDate = (d: Date | string | null | undefined) =>
  d ? new Date(d).toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric' }) : '—';

const MODE_LABELS: Record<string, string> = { cash: 'Cash', check: 'Check', online: 'Online / Bank Transfer' };
const recordedBy = [collection.createdByFirstName, collection.createdByLastName].filter(Boolean).join(' ') || '—';
---

<MainLayout title={`Collection ${collection.collectionNo}`}>
  <div class="page-header mb-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <a href="/revenue/collections" class="text-gray-500 hover:text-gray-700" aria-label="Back to collections">
            <i class="pi pi-arrow-left"></i>
          </a>
          <h1 class="page-title font-mono">{collection.collectionNo}</h1>
          {collection.orNo
            ? <span class="badge badge-success">OR {collection.orNo}</span>
            : <span class="badge badge-warning">No OR issued</span>}
        </div>
        <p class="page-description">Collected {formatDate(collection.collectionDate)} from {collection.debtorName}</p>
      </div>
      <button type="button" class="btn btn-secondary btn-md" onclick="window.print()">
        <i class="pi pi-print mr-2" aria-hidden="true"></i>
        Print
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card lg:col-span-2">
      <div class="card-header"><h2 class="text-lg font-semibold text-gray-900">Collection Details</h2></div>
      <div class="card-body">
        <div class="mb-6 p-4 bg-green-50 rounded-lg">
          <p class="text-sm text-gray-600">Amount Collected</p>
          <p class="text-3xl font-bold text-green-700">{peso(collection.amount)}</p>
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <dt class="text-sm font-medium text-gray-600">Payment Mode</dt>
            <dd class="mt-1 text-gray-900">{MODE_LABELS[collection.paymentMode] ?? collection.paymentMode}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-600">Official Receipt</dt>
            <dd class="mt-1 text-gray-900 font-mono">{collection.orNo || 'Not yet issued'}</dd>
          </div>
          {collection.paymentMode === 'check' && (
            <>
              <div>
                <dt class="text-sm font-medium text-gray-600">Check No.</dt>
                <dd class="mt-1 text-gray-900 font-mono">{collection.checkNo || '—'}</dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-600">Check Date / Bank</dt>
                <dd class="mt-1 text-gray-900">{formatDate(collection.checkDate)} · {collection.checkBank || '—'}</dd>
              </div>
            </>
          )}
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-600">Remarks</dt>
            <dd class="mt-1 text-gray-900">{collection.remarks || '—'}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-600">Recorded By</dt>
            <dd class="mt-1 text-gray-900">{recordedBy}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-600">Recorded On</dt>
            <dd class="mt-1 text-gray-900">{formatDate(collection.createdAt)}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h2 class="text-lg font-semibold text-gray-900">Receivable</h2></div>
      <div class="card-body space-y-3">
        <div>
          <p class="text-sm text-gray-600">AR No.</p>
          <p class="font-mono font-semibold text-gray-900">{collection.arNo}</p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Debtor</p>
          <p class="text-gray-900">{collection.debtorName}</p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Invoice No.</p>
          <p class="text-gray-900">{collection.invoiceNo || '—'}</p>
        </div>
        <div>
          <p class="text-sm text-gray-600">Revenue Source</p>
          <p class="text-gray-900">{collection.revenueSourceName || '—'}</p>
        </div>
        <a href={`/revenue/receivables/${collection.arId}`} class="btn btn-secondary btn-sm w-full">View Receivable &amp; Balance</a>
      </div>
    </div>
  </div>
</MainLayout>
