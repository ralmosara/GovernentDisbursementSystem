---
import MainLayout from '../layouts/MainLayout.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { budgetService } from '../lib/services/budget.service';
import { workQueueService, formatWaiting, STAGE_LABELS } from '../lib/services/work-queue.service';
import { insightsService } from '../lib/services/insights.service';

const user = Astro.locals.user;

const now = new Date();
const currentYear = now.getFullYear();

const [budgetSummary, allotments, queue, cycleTimes] = await Promise.all([
  budgetService.getOverallBudgetSummary(currentYear),
  budgetService.getAllotments(),
  user ? workQueueService.getQueue({ id: user.id, roles: user.roles ?? [] }) : null,
  insightsService.getApprovalCycleTimes(90).catch(() => null),
]);

// One list of everything waiting on this user, oldest first
const attention = [
  ...(queue?.approvals ?? []).map(item => ({
    kind: `${STAGE_LABELS[item.stage]} approval`,
    icon: 'pi-file-edit',
    title: `${item.dvNo} · ${item.payeeName}`,
    subtitle: item.particulars,
    amount: item.amount,
    href: `/disbursements/${item.dvId}`,
    since: item.waitingSince,
  })),
  ...(queue?.obligations ?? []).map(item => ({
    kind: 'Obligation',
    icon: 'pi-book',
    title: item.payee,
    subtitle: `${item.orsNumber ? `${item.orsNumber} · ` : ''}${item.particulars}`,
    amount: item.amount,
    href: `/budget/obligations/${item.id}`,
    since: new Date(item.createdAt ?? item.obligationDate),
  })),
]
  .sort((a, b) => a.since.getTime() - b.since.getTime())
  .map(item => ({ ...item, waiting: formatWaiting(item.since, now), days: (now.getTime() - item.since.getTime()) / 864e5 }));

// ---------- Formatting ----------
const peso = (value: number, fractionDigits = 2) =>
  `₱${(value || 0).toLocaleString('en-PH', { minimumFractionDigits: fractionDigits, maximumFractionDigits: fractionDigits })}`;

// Compact amounts for stat tiles; the full figure goes in the tooltip
const pesoCompact = (value: number) => {
  const abs = Math.abs(value || 0);
  if (abs >= 1e9) return `₱${(value / 1e9).toFixed(2)}B`;
  if (abs >= 1e6) return `₱${(value / 1e6).toFixed(2)}M`;
  if (abs >= 1e3) return `₱${(value / 1e3).toFixed(1)}K`;
  return peso(value, 0);
};

// Hours as "6h" or "2.5d" for the approval-speed panel
const formatHours = (hours: number) => (hours < 24 ? `${Math.round(hours)}h` : `${(hours / 24).toFixed(1)}d`);
const slowestStageHours = Math.max(1, ...(cycleTimes?.stages.map(s => s.medianHours) ?? [1]));

const hour = now.getHours();
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

// ---------- Budget pacing telemetry ----------
// Compare how much of the allotment is obligated against how much of the fiscal
// year has elapsed, and project a year-end figure at the current pace.
const startOfYear = new Date(currentYear, 0, 1).getTime();
const endOfYear = new Date(currentYear + 1, 0, 1).getTime();
const yearElapsed = ((now.getTime() - startOfYear) / (endOfYear - startOfYear)) * 100;

const utilization = budgetSummary.utilizationRate;
const projectedYearEnd = yearElapsed > 0 ? (utilization / yearElapsed) * 100 : 0;
const hasBudget = budgetSummary.allotment > 0;

type Pace = { label: string; lozenge: string; icon: string; message: string };
const pace: Pace = !hasBudget
  ? {
      label: 'No allotments',
      lozenge: 'badge',
      icon: 'pi-info-circle',
      message: `No allotments have been released for FY ${currentYear} yet.`,
    }
  : utilization >= 95
    ? {
        label: 'At limit',
        lozenge: 'badge badge-danger',
        icon: 'pi-exclamation-circle',
        message: 'Obligations have nearly used the full allotment. New obligations may fail budget checks.',
      }
    : utilization > yearElapsed + 15 || projectedYearEnd > 100
      ? {
          label: 'Ahead of pace',
          lozenge: 'badge badge-warning',
          icon: 'pi-exclamation-triangle',
          message: `At this pace, obligations will reach ${Math.round(projectedYearEnd)}% of the allotment by year end.`,
        }
      : utilization < yearElapsed - 25
        ? {
            label: 'Behind pace',
            lozenge: 'badge badge-info',
            icon: 'pi-info-circle',
            message: `At this pace, only ${Math.round(projectedYearEnd)}% of the allotment will be obligated by year end.`,
          }
        : {
            label: 'On pace',
            lozenge: 'badge badge-success',
            icon: 'pi-check-circle',
            message: `Obligations are tracking the calendar. Projected year-end: ${Math.round(projectedYearEnd)}% of allotment.`,
          };

const meterFill = Math.min(Math.max(utilization, 0), 100);
const meterMarker = Math.min(Math.max(yearElapsed, 0), 100);

// ---------- Jobs people come here to do ----------
const jobs = [
  {
    href: '/disbursements/create',
    icon: 'pi-file-edit',
    title: 'Pay someone',
    description: 'Prepare a disbursement voucher for a supplier, employee or claimant.',
  },
  {
    href: '/budget/obligations/create',
    icon: 'pi-book',
    title: 'Commit funds',
    description: 'Raise an obligation request against an available allotment.',
  },
  {
    href: '/travel/itinerary/create',
    icon: 'pi-map-marker',
    title: 'Plan official travel',
    description: 'File an itinerary and request a cash advance.',
  },
  {
    href: '/cash/receipts/create',
    icon: 'pi-money-bill',
    title: 'Record money received',
    description: 'Issue an official receipt for a collection.',
  },
  {
    href: '/cash/reconciliations/create',
    icon: 'pi-check-square',
    title: 'Close the month',
    description: 'Reconcile the books against the bank statement.',
  },
  {
    href: '/reports',
    icon: 'pi-chart-bar',
    title: 'Report to oversight',
    description: 'Generate FAR, BAR, asset and inventory reports.',
  },
];

const stats = [
  {
    label: 'Appropriation',
    value: budgetSummary.appropriation,
    help: 'Authorised by the GAA for the year',
  },
  {
    label: 'Allotment',
    value: budgetSummary.allotment,
    help: 'Released and available to obligate',
  },
  {
    label: 'Obligated',
    value: budgetSummary.obligation,
    help: `Certified obligations, FY ${currentYear}`,
  },
  {
    label: 'Unobligated balance',
    value: budgetSummary.unobligatedBalance,
    help: 'Still free to commit',
  },
];
---

<MainLayout title="Home - Philippine Government FMS">
  <!-- Page header -->
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <p class="text-sm text-gray-600" data-volatile>
        {now.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric' })} · FY {currentYear}
      </p>
      <h1 class="page-title mt-1" data-volatile>{greeting}, {user?.firstName}</h1>
    </div>
    <div class="page-actions">
      <a href="/reports" class="btn btn-secondary">
        <i class="pi pi-chart-bar" aria-hidden="true"></i>
        Reports
      </a>
      <a href="/disbursements/create" class="btn btn-primary">
        <i class="pi pi-plus" aria-hidden="true"></i>
        New disbursement voucher
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Main column -->
    <div class="xl:col-span-2 space-y-6 min-w-0">
      <!-- Needs your attention: the same role-aware queue as /approvals -->
      <section class="card" aria-labelledby="attention-heading">
        <div class="card-header">
          <div class="flex items-center gap-2">
            <h2 id="attention-heading" class="card-title">Needs your attention</h2>
            <span class="badge">{attention.length}</span>
          </div>
          <a href="/approvals" class="text-sm font-medium text-primary-600 hover:underline">Open approvals</a>
        </div>

        {attention.length === 0 ? (
          <EmptyState
            tone="success"
            title="You're all caught up"
            description={queue.blocked.length
              ? `${queue.blocked.length} voucher${queue.blocked.length === 1 ? '' : 's'} at your stage need another approver (segregation of duties).`
              : 'Nothing is waiting for your decision right now.'}
          />
        ) : (
          <ul class="divide-y divide-gray-200">
            {attention.slice(0, 6).map(item => (
              <li>
                <a href={item.href} class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50">
                  <span class="flex items-center justify-center w-8 h-8 rounded bg-primary-100 shrink-0" aria-hidden="true">
                    <i class={`pi ${item.icon} text-primary-600 text-sm`}></i>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2">
                      <span class="font-medium text-gray-800 truncate">{item.title}</span>
                      <span class="badge shrink-0">{item.kind}</span>
                    </span>
                    <span class="block text-xs text-gray-500 truncate">{item.subtitle}</span>
                  </span>
                  <span class="text-right shrink-0">
                    <span class="block font-medium tabular-nums">{peso(item.amount)}</span>
                    <span class={`block text-xs ${item.days >= 3 ? 'text-orange-700 font-medium' : 'text-gray-500'}`}>
                      {item.days >= 3 && <i class="pi pi-clock !text-[10px] mr-0.5" aria-hidden="true"></i>}
                      Waiting {item.waiting}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
        {attention.length > 6 && (
          <div class="card-footer !justify-center">
            <a href="/approvals" class="text-sm font-medium text-primary-600 hover:underline">View all {attention.length}</a>
          </div>
        )}
      </section>

      <!-- Jobs to be done -->
      <section aria-labelledby="jobs-heading">
        <h2 id="jobs-heading" class="section-title">What do you need to do?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {jobs.map(job => (
            <a href={job.href} class="card group flex items-start gap-3 p-4">
              <span class="flex items-center justify-center w-9 h-9 rounded bg-primary-100 shrink-0">
                <i class={`pi ${job.icon} text-primary-600`} aria-hidden="true"></i>
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-1 font-semibold text-gray-800 group-hover:text-primary-600">
                  {job.title}
                  <i class="pi pi-arrow-right text-[10px] opacity-0 -translate-x-1 transition group-hover:opacity-100 group-hover:translate-x-0" aria-hidden="true"></i>
                </span>
                <span class="block mt-0.5 text-xs text-gray-600">{job.description}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- Recent allotments -->
      <section class="card" aria-labelledby="allotments-heading">
        <div class="card-header">
          <h2 id="allotments-heading" class="card-title">Recent allotments</h2>
          <a href="/budget/allotments" class="text-sm font-medium text-primary-600 hover:underline">View all</a>
        </div>
        {allotments.length === 0 ? (
          <div class="empty-state">
            <i class="pi pi-inbox text-2xl text-gray-400 mb-2" aria-hidden="true"></i>
            <p class="text-sm">No allotments released yet.</p>
            <a href="/budget/allotments/create" class="btn btn-secondary btn-sm mt-3">Create allotment</a>
          </div>
        ) : (
          <div class="relative overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Object of expenditure</th>
                  <th scope="col" class="hidden md:table-cell">Fund cluster</th>
                  <th scope="col">Class</th>
                  <th scope="col" class="!text-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                {allotments.slice(0, 5).map(allotment => (
                  <tr class="hover:bg-gray-50">
                    <td>
                      <a href={`/budget/allotments/${allotment.id}`} class="font-medium text-gray-800 hover:text-primary-600 hover:underline">
                        {allotment.objectOfExpenditure.name}
                      </a>
                    </td>
                    <td class="hidden md:table-cell text-gray-600">{allotment.appropriation.fundCluster.name}</td>
                    <td><span class="badge">{allotment.allotmentClass}</span></td>
                    <td class="text-right font-medium tabular-nums whitespace-nowrap">{peso(allotment.amount, 0)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>

    <!-- Side column: budget telemetry -->
    <aside class="space-y-6 min-w-0" aria-label="Budget health">
      <section class="card" aria-labelledby="budget-heading">
        <div class="card-header">
          <h2 id="budget-heading" class="card-title">Budget health</h2>
          <span class={pace.lozenge}>
            <i class={`pi ${pace.icon} !text-[10px]`} aria-hidden="true"></i>
            {pace.label}
          </span>
        </div>
        <div class="card-body">
          <p class="text-xs font-semibold text-gray-600">Obligated of allotment</p>
          <p class="mt-1 text-3xl font-semibold text-gray-800 tabular-nums">
            {utilization.toFixed(1)}<span class="text-lg text-gray-500">%</span>
          </p>

          <!-- Meter: fill = obligated share, tick = share of the year elapsed -->
          <div class="relative mt-4 mb-7" role="img"
            aria-label={`${utilization.toFixed(1)}% of allotment obligated; ${yearElapsed.toFixed(0)}% of the fiscal year has elapsed`}>
            <div class="h-2 w-full rounded bg-gray-100 overflow-hidden" title={`Unobligated: ${peso(budgetSummary.unobligatedBalance)}`}>
              <div class="h-full rounded bg-primary-600" style={`width: ${meterFill}%`} title={`Obligated: ${peso(budgetSummary.obligation)}`}></div>
            </div>
            <div class="absolute -top-1 h-4 w-0.5 bg-gray-800 rounded" style={`left: calc(${meterMarker}% - 1px)`} aria-hidden="true"></div>
            <span
              class="absolute top-4 text-[11px] text-gray-600 whitespace-nowrap -translate-x-1/2"
              style={`left: clamp(2.5rem, ${meterMarker}%, calc(100% - 2.5rem))`}
              aria-hidden="true"
            >
              Today · {yearElapsed.toFixed(0)}% of year
            </span>
          </div>

          <div class="flex items-center gap-4 text-xs text-gray-600">
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-primary-600" aria-hidden="true"></span>Obligated</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-gray-100 border border-gray-200" aria-hidden="true"></span>Unobligated</span>
          </div>

          <p class="mt-4 text-sm text-gray-700">{pace.message}</p>
        </div>

        <dl class="grid grid-cols-2 border-t border-gray-200">
          {stats.map((stat, index) => (
            <div class={`p-4 ${index % 2 === 0 ? 'border-r border-gray-200' : ''} ${index < 2 ? 'border-b border-gray-200' : ''}`}>
              <dt class="text-xs font-semibold text-gray-600">{stat.label}</dt>
              <dd class="mt-1 text-lg font-semibold text-gray-800 tabular-nums" title={peso(stat.value)}>
                {pesoCompact(stat.value)}
              </dd>
              <dd class="text-xs text-gray-500">{stat.help}</dd>
            </div>
          ))}
        </dl>
      </section>

      {cycleTimes && cycleTimes.endToEnd.count > 0 && (
        <section class="card" aria-labelledby="speed-heading">
          <div class="card-header">
            <h2 id="speed-heading" class="card-title">Approval speed</h2>
            <span class="text-xs text-gray-500">Last 90 days</span>
          </div>
          <div class="card-body">
            <p class="text-xs font-semibold text-gray-600">Median time to full approval</p>
            <p class="mt-1 text-2xl font-semibold text-gray-800 tabular-nums">{formatHours(cycleTimes.endToEnd.medianHours)}</p>
            <p class="text-xs text-gray-500">Across {cycleTimes.endToEnd.count} voucher{cycleTimes.endToEnd.count === 1 ? '' : 's'}</p>

            <dl class="mt-4 space-y-2.5">
              {cycleTimes.stages.map(stage => (
                <div>
                  <div class="flex justify-between text-xs">
                    <dt class="text-gray-600">{stage.label}</dt>
                    <dd class="font-medium text-gray-800 tabular-nums">{stage.count ? formatHours(stage.medianHours) : '—'}</dd>
                  </div>
                  <div class="mt-1 h-1.5 rounded bg-gray-100" aria-hidden="true">
                    <div class="h-full rounded bg-primary-600" style={`width: ${stage.count ? Math.max(2, (stage.medianHours / slowestStageHours) * 100) : 0}%`}></div>
                  </div>
                </div>
              ))}
            </dl>
            <a href="/reports/insights" class="inline-block mt-4 text-sm font-medium text-primary-600 hover:underline">See process insights</a>
          </div>
        </section>
      )}

      <section class="card p-4" aria-labelledby="shortcuts-heading">
        <h2 id="shortcuts-heading" class="text-xs font-semibold text-gray-600 mb-2">Shortcuts</h2>
        <ul class="space-y-0.5 -mx-2">
          <li><a href="/approvals" class="side-nav-item"><i class="pi pi-inbox" aria-hidden="true"></i>Disbursement approvals</a></li>
          <li><a href="/cash/position" class="side-nav-item"><i class="pi pi-chart-bar" aria-hidden="true"></i>Cash position</a></li>
          <li><a href="/budget/allotments" class="side-nav-item"><i class="pi pi-chart-pie" aria-hidden="true"></i>Allotment balances</a></li>
          <li><a href="/travel/liquidation" class="side-nav-item"><i class="pi pi-receipt" aria-hidden="true"></i>Travel liquidations</a></li>
        </ul>
        <p class="mt-3 px-0.5 text-xs text-gray-500">
          Tip: press <span class="kbd">/</span> anywhere to jump to any page.
        </p>
      </section>
    </aside>
  </div>
</MainLayout>
