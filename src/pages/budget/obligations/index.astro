---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import FilterBar from '../../../components/ui/FilterBar.astro';
import DataTable from '../../../components/ui/DataTable.astro';
import StatTile from '../../../components/ui/StatTile.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Lozenge from '../../../components/ui/Lozenge.astro';
import { budgetService } from '../../../lib/services/budget.service';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const status = Astro.url.searchParams.get('status') || '';
const allotmentFilter = parseInt(Astro.url.searchParams.get('allotment') || '0');

// Summary counts cover every obligation (within the allotment filter), so they
// still make sense while a status filter is applied
const allObligations = await budgetService.getObligations();
const inScope = allotmentFilter ? allObligations.filter(o => o.allotmentId === allotmentFilter) : allObligations;
const obligations = status ? inScope.filter(o => o.status === status) : inScope;

const sumOf = (list: typeof inScope) => list.reduce((sum, o) => sum + o.amount, 0);
const byStatus = (s: string) => inScope.filter(o => o.status === s);
const pending = byStatus('pending');
const approved = byStatus('approved');
const rejected = byStatus('rejected');

const canCertify = (user.roles ?? []).some(role => role === 'budget_officer' || role === 'administrator');
const activeFilters = [status, allotmentFilter || ''].filter(Boolean).length;

const peso = (value: number) =>
  `₱${value.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const formatDate = (date: Date | string) =>
  new Date(date).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
const statusHref = (s: string) => `/budget/obligations?${new URLSearchParams({ status: s, ...(allotmentFilter ? { allotment: String(allotmentFilter) } : {}) })}`;
---

<MainLayout title="Obligations - Philippine Government FMS">
  <PageHeader
    title="Registry of obligations"
    description="Commit funds against allotments and track ORS/BURS numbers."
    breadcrumbs={[{ label: 'Budget', href: '/budget/allotments' }, { label: 'Obligations' }]}
  >
    <a slot="actions" href={`/budget/obligations/create${allotmentFilter ? `?allotment=${allotmentFilter}` : ''}`} class="btn btn-primary">
      <i class="pi pi-plus" aria-hidden="true"></i>
      New obligation
    </a>
  </PageHeader>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <StatTile label="Awaiting certification" value={pending.length} help={peso(sumOf(pending))} icon="pi-clock" href={statusHref('pending')} />
    <StatTile label="Approved" value={approved.length} help={peso(sumOf(approved))} icon="pi-check-circle" href={statusHref('approved')} />
    <StatTile label="Rejected" value={rejected.length} help={peso(sumOf(rejected))} icon="pi-times-circle" href={statusHref('rejected')} />
    <StatTile label="All obligations" value={inScope.length} help={peso(sumOf(inScope))} icon="pi-book" href={allotmentFilter ? `/budget/obligations?allotment=${allotmentFilter}` : '/budget/obligations'} />
  </div>

  <FilterBar action="/budget/obligations" resetHref="/budget/obligations" activeCount={activeFilters}>
    {allotmentFilter ? <input type="hidden" name="allotment" value={allotmentFilter} /> : null}
    <div class="form-group">
      <label for="status" class="form-label">Status</label>
      <select name="status" id="status" class="form-select">
        <option value="">Any status</option>
        <option value="pending" selected={status === 'pending'}>Pending</option>
        <option value="approved" selected={status === 'approved'}>Approved</option>
        <option value="rejected" selected={status === 'rejected'}>Rejected</option>
      </select>
    </div>
  </FilterBar>

  {obligations.length === 0 ? (
    <div class="card">
      <EmptyState
        icon="pi-book"
        title={activeFilters ? 'No obligations match these filters' : 'No obligations yet'}
        description={activeFilters ? 'Try another status or clear the filters.' : 'Record an obligation to commit funds against an allotment.'}
      >
        {activeFilters ? (
          <a href="/budget/obligations" class="btn btn-secondary">Clear filters</a>
        ) : (
          <a href="/budget/obligations/create" class="btn btn-primary">Create an obligation</a>
        )}
      </EmptyState>
    </div>
  ) : (
    <DataTable title="Obligations" count={obligations.length} quickFilter quickFilterLabel="Filter by payee, ORS…">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">ORS/BURS</th>
            <th scope="col">Payee</th>
            <th scope="col" class="hidden md:table-cell">Fund</th>
            <th scope="col" class="hidden lg:table-cell">Object of expenditure</th>
            <th scope="col">Date</th>
            <th scope="col" class="!text-right">Amount</th>
            <th scope="col">Status</th>
            <th scope="col" data-nosort><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {obligations.map(obligation => (
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap">
                <a href={`/budget/obligations/${obligation.id}`} class="font-medium text-primary-600 hover:underline">
                  {obligation.orsNumber || obligation.bursNumber || `#${obligation.id}`}
                </a>
                {obligation.orsNumber && obligation.bursNumber && <p class="text-xs text-gray-500">BURS {obligation.bursNumber}</p>}
              </td>
              <td class="max-w-[16rem]">
                <p class="truncate" title={obligation.payee}>{obligation.payee}</p>
                <p class="text-xs text-gray-500 truncate" title={obligation.particulars}>{obligation.particulars}</p>
              </td>
              <td class="hidden md:table-cell text-gray-600">{obligation.allotment.appropriation.fundCluster.code}</td>
              <td class="hidden lg:table-cell max-w-[14rem]">
                <p class="truncate text-gray-600" title={obligation.allotment.objectOfExpenditure.name}>
                  {obligation.allotment.objectOfExpenditure.code} · {obligation.allotment.objectOfExpenditure.name}
                </p>
              </td>
              <td class="whitespace-nowrap text-gray-600" data-sort-value={new Date(obligation.obligationDate).getTime()}>{formatDate(obligation.obligationDate)}</td>
              <td class="text-right font-medium tabular-nums whitespace-nowrap" data-sort-value={obligation.amount}>{peso(obligation.amount)}</td>
              <td><Lozenge status={obligation.status} /></td>
              <td class="text-right whitespace-nowrap">
                {obligation.status === 'pending' && canCertify ? (
                  <a href={`/budget/obligations/${obligation.id}`} class="btn btn-primary btn-sm">Review</a>
                ) : obligation.status === 'approved' ? (
                  <a href={`/budget/obligations/${obligation.id}`} class="btn btn-subtle btn-sm">Open</a>
                ) : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </DataTable>
  )}
</MainLayout>
