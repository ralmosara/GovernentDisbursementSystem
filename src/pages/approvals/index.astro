---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import DataTable from '../../components/ui/DataTable.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Lozenge from '../../components/ui/Lozenge.astro';
import Banner from '../../components/ui/Banner.astro';
import StatTile from '../../components/ui/StatTile.astro';
import { workQueueService, formatWaiting, STAGE_LABELS } from '../../lib/services/work-queue.service';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const queue = await workQueueService.getQueue({ id: user.id, roles: user.roles ?? [] });

// Optional stage filter from the tabs
const stageFilter = Astro.url.searchParams.get('stage') ?? '';
const approvals = stageFilter ? queue.approvals.filter(item => item.stage === stageFilter) : queue.approvals;

const stageCounts = Object.keys(STAGE_LABELS)
  .map(stage => ({ stage, label: STAGE_LABELS[stage], count: queue.approvals.filter(a => a.stage === stage).length }))
  .filter(s => s.count > 0);

const peso = (value: number) =>
  `₱${value.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const formatDate = (value: Date | string | null) =>
  value ? new Date(value).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';

const now = new Date();
const daysWaiting = (since: Date) => (now.getTime() - since.getTime()) / 864e5;
const overdue = queue.approvals.filter(item => daysWaiting(item.waitingSince) >= 3).length;
const totalValue = queue.approvals.reduce((sum, item) => sum + item.amount, 0);
const roleLabels = (user.roles ?? []).map(role => role.replace(/_/g, ' '));
---

<MainLayout title="Approvals - Philippine Government FMS">
  <PageHeader
    title="Approvals"
    description="Everything waiting for your decision, oldest first."
    breadcrumbs={[{ label: 'Home', href: '/dashboard' }, { label: 'Approvals' }]}
  >
    <p slot="meta" class="mt-2 flex flex-wrap items-center gap-1.5 text-xs text-gray-600">
      Acting as
      {roleLabels.length ? roleLabels.map(role => <span class="badge capitalize">{role}</span>) : <span class="badge">No approval role</span>}
    </p>
  </PageHeader>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <StatTile label="Vouchers to approve" value={queue.approvals.length} icon="pi-file-edit" />
    <StatTile label="Waiting 3+ days" value={overdue} icon="pi-clock" help={overdue ? 'Oldest are listed first' : 'Nothing is overdue'} />
    <StatTile label="Value awaiting you" value={peso(totalValue)} icon="pi-wallet" />
    <StatTile label="Obligations to certify" value={queue.obligations.length} icon="pi-book" help={queue.obligations.length ? undefined : 'Budget officers only'} />
  </div>

  {queue.count === 0 && queue.blocked.length === 0 && (
    <div class="card">
      <EmptyState
        tone="success"
        title="You're all caught up"
        description="Nothing is waiting for your approval. New items appear here as soon as they reach your stage."
      >
        <a href="/dashboard" class="btn btn-secondary">Back to home</a>
      </EmptyState>
    </div>
  )}

  {queue.approvals.length > 0 && (
    <div class="mb-6">
      {stageCounts.length > 1 && (
        <nav class="flex flex-wrap gap-1 mb-3" aria-label="Filter by stage">
          <a href="/approvals" class={`btn btn-sm ${stageFilter ? 'btn-subtle' : 'btn-secondary'}`} aria-current={stageFilter ? undefined : 'page'}>
            All <span class="badge ml-1">{queue.approvals.length}</span>
          </a>
          {stageCounts.map(s => (
            <a href={`/approvals?stage=${s.stage}`} class={`btn btn-sm ${stageFilter === s.stage ? 'btn-secondary' : 'btn-subtle'}`} aria-current={stageFilter === s.stage ? 'page' : undefined}>
              {s.label} <span class="badge ml-1">{s.count}</span>
            </a>
          ))}
        </nav>
      )}

      <DataTable title="Disbursement vouchers" count={approvals.length} quickFilter quickFilterLabel="Filter by payee, DV no.…">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">DV no.</th>
              <th scope="col">Payee</th>
              <th scope="col" class="hidden lg:table-cell">Particulars</th>
              <th scope="col">Stage</th>
              <th scope="col">Waiting</th>
              <th scope="col" class="!text-right">Amount</th>
              <th scope="col" data-nosort><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {approvals.map(item => {
              const days = daysWaiting(item.waitingSince);
              return (
                <tr class="hover:bg-gray-50">
                  <td class="whitespace-nowrap">
                    <a href={`/disbursements/${item.dvId}`} class="font-medium text-primary-600 hover:underline">{item.dvNo}</a>
                    <p class="text-xs text-gray-500">{formatDate(item.dvDate)}</p>
                  </td>
                  <td class="max-w-[14rem]"><p class="truncate" title={item.payeeName}>{item.payeeName}</p></td>
                  <td class="hidden lg:table-cell max-w-[20rem]"><p class="truncate text-gray-600" title={item.particulars}>{item.particulars}</p></td>
                  <td><span class="badge">{STAGE_LABELS[item.stage]}</span></td>
                  <td class="whitespace-nowrap" data-sort-value={Math.round(days * 24)}>
                    {days >= 3 ? (
                      <Lozenge appearance="moved" icon="pi-clock" label={formatWaiting(item.waitingSince, now)} />
                    ) : (
                      <span class="text-gray-600">{formatWaiting(item.waitingSince, now)}</span>
                    )}
                  </td>
                  <td class="text-right font-medium tabular-nums whitespace-nowrap" data-sort-value={item.amount}>{peso(item.amount)}</td>
                  <td class="text-right">
                    <a href={`/disbursements/${item.dvId}`} class="btn btn-primary btn-sm">Review</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DataTable>
    </div>
  )}

  {queue.obligations.length > 0 && (
    <div class="mb-6">
      <DataTable title="Obligation requests to certify" count={queue.obligations.length}>
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Payee</th>
              <th scope="col" class="hidden md:table-cell">ORS no.</th>
              <th scope="col">Requested</th>
              <th scope="col" class="!text-right">Amount</th>
              <th scope="col" data-nosort><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {queue.obligations.map(item => (
              <tr class="hover:bg-gray-50">
                <td class="max-w-[18rem]">
                  <a href={`/budget/obligations/${item.id}`} class="font-medium text-primary-600 hover:underline">{item.payee}</a>
                  <p class="text-xs text-gray-500 truncate">{item.particulars}</p>
                </td>
                <td class="hidden md:table-cell text-gray-600">{item.orsNumber || '—'}</td>
                <td class="whitespace-nowrap text-gray-600" data-sort-value={item.createdAt ? new Date(item.createdAt).getTime() : 0}>
                  {formatDate(item.obligationDate)}
                </td>
                <td class="text-right font-medium tabular-nums whitespace-nowrap" data-sort-value={item.amount}>{peso(item.amount)}</td>
                <td class="text-right"><a href={`/budget/obligations/${item.id}`} class="btn btn-primary btn-sm">Review</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </DataTable>
    </div>
  )}

  {queue.blocked.length > 0 && (
    <section aria-labelledby="blocked-heading">
      <Banner appearance="info" title={`${queue.blocked.length} voucher${queue.blocked.length === 1 ? ' is' : 's are'} at your stage but needs another approver`}>
        Segregation of duties stops you approving a voucher you prepared or already approved at an earlier stage.
        Another officer with the same role needs to act on these.
      </Banner>
      <ul class="mt-3 card divide-y divide-gray-200" id="blocked-heading">
        {queue.blocked.map(item => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
            <span>
              <a href={`/disbursements/${item.dvId}`} class="font-medium text-primary-600 hover:underline">{item.dvNo}</a>
              <span class="text-gray-600"> · {item.payeeName}</span>
            </span>
            <span class="flex items-center gap-2 text-sm text-gray-600">
              <span class="badge">{STAGE_LABELS[item.stage]}</span>
              {item.blockedReason}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}
</MainLayout>
