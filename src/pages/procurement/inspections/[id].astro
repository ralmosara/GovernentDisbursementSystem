---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Lozenge from '../../../components/ui/Lozenge.astro';
import Banner from '../../../components/ui/Banner.astro';
import { procurementService } from '../../../lib/services/procurement.service';
import { getSetting } from '../../../lib/services/settings.service';
import { db } from '../../../lib/db/connection';
import { inventoryItems } from '../../../lib/db/schema';
import { asc, eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const id = parseInt(Astro.params.id ?? '');
const iar = id ? await procurementService.getIar(id) : null;
if (!iar) return Astro.redirect('/procurement/orders?view=deliveries');

const [agencyName, stockItems, stockReceipts] = await Promise.all([
  getSetting('agency_name').catch(() => ''),
  db.select({ id: inventoryItems.id, itemCode: inventoryItems.itemCode, itemName: inventoryItems.itemName, unit: inventoryItems.unit })
    .from(inventoryItems).where(eq(inventoryItems.isActive, true)).orderBy(asc(inventoryItems.itemName)),
  procurementService.getStockReceipts(iar.iarNo),
]);
const stockLines = iar.items.map(item => ({ ...item, receipt: stockReceipts.get(procurementService.stockReference(iar.iarNo, item.itemNo)) ?? null }));
const canReceive = stockItems.length > 0 && stockLines.some(l => !l.receipt);
const dvHref = iar.dvId ? `/disbursements/${iar.dvId}` : `/disbursements/create?${procurementService.dvPrefillForIar(iar)}`;
const peso = (value: string | number) => `₱${parseFloat(String(value)).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const formatDate = (date: Date | string | null) => (date ? new Date(date).toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric' }) : '—');
const created = Astro.url.searchParams.get('created');
---

<MainLayout title={`${iar.iarNo} - Philippine Government FMS`}>
  <PageHeader title={iar.iarNo} breadcrumbs={[{ label: 'Deliveries', href: '/procurement/orders?view=deliveries' }, { label: iar.iarNo }]}>
    <p slot="meta" class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-600">
      <Lozenge status={iar.acceptance === 'complete' ? 'completed' : 'partial'} label={iar.acceptance === 'complete' ? 'Complete delivery' : 'Partial delivery'} />
      <span>{iar.po.supplierName}</span>
      <span aria-hidden="true">·</span>
      <span class="font-medium text-gray-800 tabular-nums">{peso(iar.totalAmount)}</span>
    </p>
    <Fragment slot="actions">
      <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="pi pi-print" aria-hidden="true"></i>Print IAR</button>
      <a href={dvHref} class={`btn ${iar.dvId ? 'btn-secondary' : 'btn-primary'}`}>
        <i class="pi pi-file-edit" aria-hidden="true"></i>
        {iar.dvId ? 'Open voucher' : 'Create voucher'}
      </a>
    </Fragment>
  </PageHeader>

  {created && (
    <Banner appearance="success" title="Delivery accepted" class="mb-6 no-print" role="status">
      Create the disbursement voucher to pay {iar.po.supplierName}; it will be filled in from this report.
    </Banner>
  )}
  {!iar.po.orsBursNo && !iar.dvId && (
    <Banner appearance="warning" class="mb-6 no-print">
      The purchase order has no obligation (ORS/BURS) yet. <a href={`/procurement/orders/${iar.po.id}`} class="font-medium text-primary-600 hover:underline">Raise it</a> before paying.
    </Banner>
  )}

  <article class="card" aria-label="Inspection and acceptance report">
    <header class="px-6 pt-6 pb-4 text-center border-b border-gray-200">
      <p class="text-lg font-semibold text-gray-800">INSPECTION AND ACCEPTANCE REPORT</p>
      {agencyName && <p class="text-sm text-gray-600">{agencyName}</p>}
    </header>
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 px-6 py-4 border-b border-gray-200 text-sm">
      <div class="col-span-2"><dt class="form-label">Supplier</dt><dd class="font-semibold">{iar.po.supplierName}</dd></div>
      <div><dt class="form-label">IAR no.</dt><dd>{iar.iarNo}</dd></div>
      <div><dt class="form-label">Date</dt><dd>{formatDate(iar.iarDate)}</dd></div>
      <div><dt class="form-label">PO no.</dt><dd><a href={`/procurement/orders/${iar.po.id}`} class="text-primary-600 hover:underline">{iar.po.poNo}</a></dd></div>
      <div><dt class="form-label">PO date</dt><dd>{formatDate(iar.po.poDate)}</dd></div>
      <div><dt class="form-label">Invoice no.</dt><dd>{iar.invoiceNo ?? '—'}</dd></div>
      <div><dt class="form-label">Invoice date</dt><dd>{formatDate(iar.invoiceDate)}</dd></div>
    </dl>
    <div class="relative overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Stock/property no.</th>
            <th scope="col">Description</th>
            <th scope="col">Unit</th>
            <th scope="col" class="!text-right">Quantity</th>
            <th scope="col" class="!text-right">Value</th>
          </tr>
        </thead>
        <tbody>
          {iar.items.map(item => (
            <tr>
              <td>{item.itemNo}</td>
              <td>{item.description}</td>
              <td>{item.unit}</td>
              <td class="text-right tabular-nums">{parseFloat(item.quantity)}</td>
              <td class="text-right tabular-nums">{peso(item.amount)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-gray-200 font-semibold">
            <th scope="row" colspan="4" class="!text-sm !text-gray-800">Total</th>
            <td class="text-right tabular-nums">{peso(iar.totalAmount)}</td>
          </tr>
        </tfoot>
      </table>
    </div>
    {iar.remarks && <p class="px-6 py-3 border-t border-gray-200 text-sm"><span class="form-label">Remarks</span>{iar.remarks}</p>}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 px-6 pt-6 pb-6 text-sm border-t border-gray-200">
      <div>
        <p class="form-label">Inspection</p>
        <p class="text-gray-700">Date inspected: {formatDate(iar.dateInspected)}</p>
        <p class="text-gray-700">Inspected, verified and found in order as to quantity and specifications.</p>
        <div class="mt-8 border-t border-gray-400 pt-1">{iar.inspectedBy}<span class="block text-gray-600">Inspection Officer / Committee</span></div>
      </div>
      <div>
        <p class="form-label">Acceptance</p>
        <p class="text-gray-700">Date received: {formatDate(iar.dateReceived)}</p>
        <p class="text-gray-700">{iar.acceptance === 'complete' ? 'Complete' : 'Partial'}</p>
        <div class="mt-8 border-t border-gray-400 pt-1">{iar.receivedBy}<span class="block text-gray-600">Supply and/or Property Custodian</span></div>
      </div>
    </div>
  </article>
  <section class="card mt-6 no-print" aria-labelledby="stock-heading">
    <div class="card-header">
      <h2 id="stock-heading" class="card-title">Receive into stock</h2>
      <span class="text-xs text-gray-500">For supplies kept in inventory; skip lines used straight away</span>
    </div>
    {stockItems.length === 0 ? (
      <p class="px-5 py-4 text-sm text-gray-600">No stock items are set up. <a href="/inventory/items/create" class="text-primary-600 hover:underline">Add inventory items</a> to receive deliveries into stock.</p>
    ) : (
      <form id="stock-form">
        <div class="relative overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Delivered item</th>
                <th scope="col" class="!text-right">Qty</th>
                <th scope="col">Stock item</th>
              </tr>
            </thead>
            <tbody>
              {stockLines.map(line => (
                <tr data-po-item={line.poItemId}>
                  <td>{line.description}<span class="block text-xs text-gray-500">{line.unit}</span></td>
                  <td class="text-right tabular-nums">{parseFloat(line.quantity)}</td>
                  <td>
                    {line.receipt ? (
                      <span class="flex items-center gap-2">
                        <Lozenge status="completed" label="Received" />
                        <a href={`/inventory/transactions/${line.receipt.id}`} class="text-sm text-primary-600 hover:underline">{line.receipt.transactionNo}</a>
                      </span>
                    ) : (
                      <select class="form-select" data-field="inventoryItemId" aria-label={`Stock item for ${line.description}`}>
                        <option value="">Don't receive into stock</option>
                        {stockItems.map(s => <option value={s.id}>{s.itemCode} – {s.itemName} ({s.unit})</option>)}
                      </select>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {canReceive && (
          <div class="card-footer">
            <p id="stock-error" class="form-error hidden mr-auto" role="alert"></p>
            <button type="submit" class="btn btn-primary">Receive into stock</button>
          </div>
        )}
      </form>
    )}
  </section>

  <script define:vars={{ iarId: iar.id }}>
    const stockForm = document.getElementById('stock-form');
    stockForm?.addEventListener('submit', async event => {
      event.preventDefault();
      const error = document.getElementById('stock-error');
      const lines = Array.from(stockForm.querySelectorAll('tr[data-po-item]'))
        .map(row => ({ poItemId: row.dataset.poItem, inventoryItemId: row.querySelector('[data-field="inventoryItemId"]')?.value }))
        .filter(line => line.inventoryItemId);
      const response = await fetch(`/api/procurement/inspections/${iarId}/receive`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lines }),
      });
      const result = await response.json();
      if (response.ok) window.location.reload();
      else {
        error.textContent = result.message;
        error.classList.remove('hidden');
      }
    });
  </script>
</MainLayout>
