---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import FilterBar from '../../../components/ui/FilterBar.astro';
import Banner from '../../../components/ui/Banner.astro';
import StatementHeader from '../../../components/reports/StatementHeader.astro';
import { db } from '../../../lib/db/connection';
import { fundClusters } from '../../../lib/db/schema';
import { financialStatementsService } from '../../../lib/services/financial-statements.service';
import { getSetting } from '../../../lib/services/settings.service';
import { statementAmount, longDate, dateParam } from '../../../lib/ui/statement';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const params = Astro.url.searchParams;
const today = new Date();
const to = dateParam(params.get('to'), new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59), true);
const from = dateParam(params.get('from'), new Date(to.getFullYear(), 0, 1), false);
const fundClusterId = parseInt(params.get('fund') ?? '') || undefined;

const [statement, clusters, agencyName] = await Promise.all([
  financialStatementsService.getCashFlows(from, to, fundClusterId),
  db.select({ id: fundClusters.id, code: fundClusters.code, name: fundClusters.name }).from(fundClusters),
  getSetting('agency_name').catch(() => ''),
]);

const cluster = clusters.find(c => c.id === fundClusterId);
const TITLES = { operating: 'Cash flows from operating activities', investing: 'Cash flows from investing activities', financing: 'Cash flows from financing activities' };
---

<MainLayout title="Statement of Cash Flows - Philippine Government FMS">
  <PageHeader
    title="Statement of Cash Flows"
    description="Cash received and paid during the period (direct method), from every posted entry that moved a cash account."
    breadcrumbs={[{ label: 'Reports', href: '/reports' }, { label: 'Financial statements', href: '/reports/statements' }, { label: 'Cash flows' }]}
  >
    <button slot="actions" type="button" class="btn btn-secondary" onclick="window.print()">
      <i class="pi pi-print" aria-hidden="true"></i>
      Print
    </button>
  </PageHeader>

  <FilterBar action="/reports/statements/cash-flows" resetHref="/reports/statements/cash-flows" activeCount={[params.get('from'), params.get('to'), fundClusterId].filter(Boolean).length}>
    <div class="form-group">
      <label for="from" class="form-label">From</label>
      <input type="date" id="from" name="from" class="form-input" value={from.toLocaleDateString('en-CA')} />
    </div>
    <div class="form-group">
      <label for="to" class="form-label">To</label>
      <input type="date" id="to" name="to" class="form-input" value={to.toLocaleDateString('en-CA')} />
    </div>
    <div class="form-group">
      <label for="fund" class="form-label">Fund cluster</label>
      <select id="fund" name="fund" class="form-select">
        <option value="">All funds (consolidated)</option>
        {clusters.map(c => <option value={c.id} selected={fundClusterId === c.id}>{c.code} – {c.name}</option>)}
      </select>
    </div>
  </FilterBar>

  {!statement.reconciles && (
    <Banner appearance="error" title="Cash flows don't reconcile to the cash balance" class="mb-6">
      Beginning cash plus the net change differs from the ending cash balance. Check the <a href={`/accounting/trial-balance?asOf=${to.toLocaleDateString('en-CA')}`} class="underline">trial balance</a>.
    </Banner>
  )}

  <article class="card max-w-3xl" aria-label="Statement of Cash Flows">
    <StatementHeader
      agencyName={agencyName}
      title="Statement of Cash Flows"
      fund={cluster ? `Fund Cluster ${cluster.code} – ${cluster.name}` : 'All fund clusters'}
      period={`For the period ${longDate(from)} to ${longDate(to)}`}
    />
    <table class="table">
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Item</span></th>
          <th scope="col" class="!text-right">Amount</th>
        </tr>
      </thead>
      {statement.sections.map(section => (
        <tbody>
          <tr class="bg-gray-50"><th scope="rowgroup" colspan="2" class="!text-gray-800">{TITLES[section.activity]}</th></tr>
          {section.inflows.length === 0 && section.outflows.length === 0 ? (
            <tr><td class="pl-6 text-gray-600" colspan="2">None during the period</td></tr>
          ) : (
            <>
              {section.inflows.length > 0 && <tr><td class="pl-6 font-medium text-gray-700" colspan="2">Cash inflows</td></tr>}
              {section.inflows.map(line => (
                <tr><td class="pl-10">{line.label}</td><td class="text-right tabular-nums">{statementAmount(line.amount)}</td></tr>
              ))}
              {section.inflows.length > 0 && (
                <tr><td class="pl-6 text-gray-600">Total cash inflows</td><td class="text-right tabular-nums border-t border-gray-200">{statementAmount(section.totalInflows)}</td></tr>
              )}
              {section.outflows.length > 0 && <tr><td class="pl-6 font-medium text-gray-700" colspan="2">Cash outflows</td></tr>}
              {section.outflows.map(line => (
                <tr><td class="pl-10">{line.label}</td><td class="text-right tabular-nums">{statementAmount(line.amount)}</td></tr>
              ))}
              {section.outflows.length > 0 && (
                <tr><td class="pl-6 text-gray-600">Total cash outflows</td><td class="text-right tabular-nums border-t border-gray-200">{statementAmount(section.totalOutflows)}</td></tr>
              )}
            </>
          )}
          <tr class="font-semibold">
            <td>Net cash flows from {section.activity} activities</td>
            <td class="text-right tabular-nums border-t border-gray-200">{statementAmount(section.net)}</td>
          </tr>
        </tbody>
      ))}
      <tfoot>
        <tr class="border-t-2 border-gray-300 font-semibold">
          <th scope="row" class="!text-sm !text-gray-800">Total cash provided by/(used in) all activities</th>
          <td class="text-right tabular-nums">{statementAmount(statement.netChange)}</td>
        </tr>
        <tr>
          <th scope="row" class="!text-sm !font-normal !text-gray-700">Cash and cash equivalents, beginning</th>
          <td class="text-right tabular-nums">{statementAmount(statement.openingCash)}</td>
        </tr>
        <tr class="font-semibold">
          <th scope="row" class="!text-sm !text-gray-800">Cash and cash equivalents, ending</th>
          <td class="text-right tabular-nums border-t-2 border-gray-300">{statementAmount(statement.closingCash)}</td>
        </tr>
      </tfoot>
    </table>
  </article>
</MainLayout>
