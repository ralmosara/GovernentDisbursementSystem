---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSetting } from '../lib/services/settings.service';

// Signed-in users change their password from their profile instead
if (Astro.locals.user) {
  return Astro.redirect('/profile');
}

let agencyName = 'your agency';
let contactEmail = '';
try {
  agencyName = (await getSetting('agency_name')) || agencyName;
  contactEmail = await getSetting('contact_email');
} catch {
  // Settings are optional on this page; fall back to generic wording
}
---

<BaseLayout title="Forgot Password - Philippine Government FMS">
  <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="max-w-md w-full">
      <div class="bg-white rounded-lg shadow-lg px-6 py-8 sm:px-10">
        <div class="mb-6">
          <h1 class="text-xl font-semibold text-gray-800">Can't log in?</h1>
          <p class="text-sm text-gray-600 mt-2">
            For security, passwords for this financial system are reset in person by a system
            administrator of {agencyName}, after confirming your identity.
          </p>
        </div>

        <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700 mb-6">
          <li>Contact your system administrator or the ICT unit.</li>
          <li>Present your agency ID so they can verify your identity.</li>
          <li>Sign in with the temporary password they set, then change it right away under <strong>My Profile</strong>.</li>
        </ol>

        {contactEmail && (
          <p class="text-sm text-gray-700 mb-6">
            Agency contact: <a href={`mailto:${contactEmail}`} class="text-primary-600 hover:text-primary-700 underline">{contactEmail}</a>
          </p>
        )}

        <p class="text-xs text-gray-500 mb-6">
          If your account is locked after too many failed attempts, wait one hour or ask an administrator to help.
        </p>

        <a href="/login" class="btn btn-secondary btn-lg w-full">
          <i class="pi pi-arrow-left mr-2" aria-hidden="true"></i>
          Back to log in
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
