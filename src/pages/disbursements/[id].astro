---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ProgressTracker from '../../components/ui/ProgressTracker.astro';
import type { Step } from '../../components/ui/types';
import Lozenge from '../../components/ui/Lozenge.astro';
import Banner from '../../components/ui/Banner.astro';
import Modal from '../../components/ui/Modal.astro';
import { disbursementService } from '../../lib/services/disbursement.service';
import { approvalService } from '../../lib/services/approval.service';
import { paymentService } from '../../lib/services/payment.service';
import { workQueueService, STAGE_LABELS } from '../../lib/services/work-queue.service';
import { insightsService } from '../../lib/services/insights.service';
import { ledgerService } from '../../lib/services/ledger.service';
import { TAX_TREATMENTS } from '../../lib/utils/withholding';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

if (!id || isNaN(parseInt(id))) {
  return Astro.redirect('/disbursements');
}

const dvId = parseInt(id);
const dv = await disbursementService.getDVById(dvId);

if (!dv) {
  return Astro.redirect('/disbursements');
}

const [taxes, liabilityJev, approvalHistory, currentStage, obligation, myQueue] = await Promise.all([
  disbursementService.getDVTaxes(dvId),
  ledgerService.findBySource('dv_approval', dvId).catch(() => null),
  approvalService.getApprovalHistory(dvId),
  approvalService.getCurrentStage(dvId),
  insightsService.getObligationByReference(dv.orsBursNo).catch(() => null),
  workQueueService.getDvApprovals({ id: user.id, roles: user.roles ?? [] }),
]);

let payment = null;
if (dv.status === 'approved' || dv.status === 'paid') {
  const payments = await paymentService.getPaymentsByDVId(dvId);
  payment = payments[0] || null;
}

// Can this user act on the current stage right now?
const isOpen = ['draft', 'pending_budget', 'pending_accounting', 'pending_director'].includes(dv.status);
const canAct = isOpen && myQueue.approvals.some(item => item.dvId === dvId);
const blocked = isOpen ? myQueue.blocked.find(item => item.dvId === dvId) : undefined;

// Result of an approve/reject action, carried over the reload in the query string
const outcome = Astro.url.searchParams.get('outcome');
const nextId = parseInt(Astro.url.searchParams.get('next') ?? '') || null;
const nextNo = Astro.url.searchParams.get('nextNo') ?? '';
const remaining = parseInt(Astro.url.searchParams.get('remaining') ?? '0') || 0;

// ---------- Formatting ----------
const formatDate = (date: Date | string | null) => {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric' });
};

const formatShortDate = (date: Date | string | null) =>
  date ? new Date(date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' }) : '';

const formatDateTime = (date: Date | string | null) => {
  if (!date) return '—';
  return new Date(date).toLocaleString('en-PH', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
};

const peso = (value: number | string) =>
  `₱${parseFloat(String(value)).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const approverName = (w: { approverFirstName?: string | null; approverLastName?: string | null }) =>
  [w.approverFirstName, w.approverLastName].filter(Boolean).join(' ');

// ---------- Journey: obligation → four approvals → payment ----------
const rejected = dv.status === 'rejected' || dv.status === 'cancelled';
const steps: Step[] = [
  {
    label: 'Obligation',
    state: obligation?.status === 'approved' ? 'done' : obligation ? 'current' : 'done',
    meta: obligation ? `${dv.orsBursNo}` : `${dv.orsBursNo} (not in registry)`,
    href: obligation ? `/budget/obligations/${obligation.id}` : undefined,
  },
  ...approvalHistory.map(w => {
    const state: Step['state'] =
      w.status === 'approved' ? 'done'
        : w.status === 'rejected' ? 'failed'
          : w.status === 'skipped' ? 'skipped'
            : !rejected && currentStage?.id === w.id ? 'current'
              : 'todo';
    const meta =
      w.status === 'approved' || w.status === 'rejected'
        ? `${approverName(w) || 'Approver'} · ${formatShortDate(w.actionDate)}`
        : state === 'current' ? 'Waiting' : undefined;
    return { label: STAGE_LABELS[w.stage] ?? w.stage, state, meta };
  }),
  {
    label: 'Payment',
    state: dv.status === 'paid' ? 'done' : dv.status === 'approved' ? 'current' : rejected ? 'skipped' : 'todo',
    meta: payment?.checkNo ? `Check ${payment.checkNo}` : dv.status === 'approved' ? 'Ready to pay' : undefined,
  },
];

const PAYMENT_MODES: Record<string, string> = {
  mds_check: 'MDS check',
  commercial_check: 'Commercial check',
  ada: 'ADA',
  other: 'Other',
};
---

<MainLayout title={`${dv.dvNo} - Philippine Government FMS`}>
  <PageHeader
    title={dv.dvNo}
    breadcrumbs={[{ label: 'Disbursement vouchers', href: '/disbursements' }, { label: dv.dvNo }]}
  >
    <p slot="meta" class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-600">
      <Lozenge status={dv.status} />
      <span>{dv.payeeName}</span>
      <span aria-hidden="true">·</span>
      <span class="font-medium text-gray-800 tabular-nums">{peso(dv.amount)}</span>
    </p>
    <Fragment slot="actions">
      {(dv.status === 'approved' || dv.status === 'paid') && (
        <>
          <a href={`/disbursements/${id}/print`} target="_blank" class="btn btn-secondary">
            <i class="pi pi-print" aria-hidden="true"></i>
            Print
          </a>
          <a href={`/api/disbursements/${id}/excel`} class="btn btn-secondary">
            <i class="pi pi-file-excel" aria-hidden="true"></i>
            Excel
          </a>
        </>
      )}
      {dv.status === 'approved' && !payment && (
        <a href={`/payments/create?dvId=${dv.id}`} class="btn btn-primary">
          <i class="pi pi-credit-card" aria-hidden="true"></i>
          Create payment
        </a>
      )}
    </Fragment>
  </PageHeader>

  {outcome && (
    <Banner
      appearance={outcome === 'approved' ? 'success' : 'info'}
      title={outcome === 'approved' ? 'Voucher approved' : 'Voucher rejected'}
      class="mb-6"
      role="status"
    >
      {outcome === 'approved'
        ? dv.status === 'approved'
          ? 'All four approvals are complete. It is ready for payment.'
          : `It has moved to ${STAGE_LABELS[currentStage?.stage ?? ''] ?? 'the next'} approval.`
        : 'The preparer can see your reason in the approval history.'}
      <Fragment slot="actions">
        {nextId ? (
          <a href={`/disbursements/${nextId}`} class="text-primary-600 hover:underline">
            Next in your queue: {nextNo} ({remaining} left) →
          </a>
        ) : (
          <a href="/approvals" class="text-primary-600 hover:underline">Your queue is clear. Back to approvals</a>
        )}
      </Fragment>
    </Banner>
  )}

  <!-- Where this voucher is -->
  <section class="card p-5 mb-6" aria-label="Voucher progress">
    <ProgressTracker steps={steps} label="Voucher progress" />
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6 min-w-0">
      <section class="card">
        <div class="card-header"><h2 class="card-title">Payee</h2></div>
        <dl class="card-body grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
          <div class="md:col-span-2">
            <dt class="form-label">Payee name</dt>
            <dd class="text-base font-semibold text-gray-800">{dv.payeeName}</dd>
          </div>
          <div>
            <dt class="form-label">TIN</dt>
            <dd>{dv.payeeTin || '—'}</dd>
          </div>
          <div>
            <dt class="form-label">Address</dt>
            <dd>{dv.payeeAddress || '—'}</dd>
          </div>
        </dl>
      </section>

      <section class="card">
        <div class="card-header"><h2 class="card-title">Transaction</h2></div>
        <dl class="card-body grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
          <div class="md:col-span-2">
            <dt class="form-label">Particulars</dt>
            <dd class="whitespace-pre-wrap">{dv.particulars}</dd>
          </div>
          <div>
            <dt class="form-label">Amount</dt>
            <dd class="text-xl font-semibold text-gray-800 tabular-nums">{peso(dv.amount)}</dd>
          </div>
          <div>
            <dt class="form-label">Object of expenditure</dt>
            <dd>{dv.objectOfExpenditure ? `${dv.objectOfExpenditure.code} – ${dv.objectOfExpenditure.name}` : '—'}</dd>
          </div>
          <div>
            <dt class="form-label">ORS/BURS no.</dt>
            <dd>
              {obligation ? (
                <a href={`/budget/obligations/${obligation.id}`} class="text-primary-600 hover:underline">{dv.orsBursNo}</a>
              ) : dv.orsBursNo}
            </dd>
          </div>
          <div>
            <dt class="form-label">Fund cluster</dt>
            <dd>{dv.fundCluster ? `${dv.fundCluster.code} – ${dv.fundCluster.name}` : '—'}</dd>
          </div>
          <div>
            <dt class="form-label">Payment mode</dt>
            <dd>{PAYMENT_MODES[dv.paymentMode] ?? dv.paymentMode}</dd>
          </div>
          <div>
            <dt class="form-label">DV date · fiscal year</dt>
            <dd>{formatDate(dv.dvDate)} · FY {dv.fiscalYear}</dd>
          </div>
          {dv.responsibilityCenter && (
            <div>
              <dt class="form-label">Responsibility center</dt>
              <dd>{dv.responsibilityCenter}</dd>
            </div>
          )}
          {dv.mfoPap && (
            <div>
              <dt class="form-label">MFO/PAP</dt>
              <dd>{dv.mfoPap.code} – {dv.mfoPap.description}</dd>
            </div>
          )}
        </dl>
      </section>

      <section class="card">
        <div class="card-header">
          <h2 class="card-title">Amount due</h2>
          {liabilityJev && (
            <a href={`/accounting/journals/${liabilityJev.id}`} class="text-sm font-medium text-primary-600 hover:underline">JEV {liabilityJev.jevNo}</a>
          )}
        </div>
        <div class="card-body">
          <p class="text-sm text-gray-600 mb-3">
            {TAX_TREATMENTS.find(t => t.value === dv.taxTreatment)?.label ?? 'Taxes not recorded (voucher created before withholding was tracked)'}
          </p>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-gray-600">Gross amount</dt>
              <dd class="tabular-nums">{peso(dv.amount)}</dd>
            </div>
            {taxes.map(tax => (
              <div class="flex justify-between gap-4">
                <dt class="text-gray-600">Less: {tax.description}{tax.atc ? ` · ${tax.atc}` : ''}</dt>
                <dd class="tabular-nums">({peso(tax.amount)})</dd>
              </div>
            ))}
            <div class="flex justify-between gap-4 pt-2 border-t border-gray-200 font-semibold text-gray-800">
              <dt>Net amount payable</dt>
              <dd class="tabular-nums">{peso(dv.netAmount)}</dd>
            </div>
          </dl>
        </div>
      </section>

      {obligation && (
        <section class="card">
          <div class="card-header">
            <h2 class="card-title">Obligation balance</h2>
            <Lozenge status={obligation.status} />
          </div>
          <div class="card-body">
            <dl class="grid grid-cols-3 gap-4">
              <div>
                <dt class="form-label">Obligated</dt>
                <dd class="font-semibold tabular-nums">{peso(obligation.amount)}</dd>
              </div>
              <div>
                <dt class="form-label">On vouchers ({obligation.voucherCount})</dt>
                <dd class="font-semibold tabular-nums">{peso(obligation.committed)}</dd>
              </div>
              <div>
                <dt class="form-label">Remaining</dt>
                <dd class={`font-semibold tabular-nums ${obligation.remaining < 0 ? 'text-red-700' : ''}`}>{peso(obligation.remaining)}</dd>
              </div>
            </dl>
            {obligation.remaining < 0 && (
              <Banner appearance="warning" class="mt-4">
                Vouchers against this ORS/BURS exceed the obligation by {peso(Math.abs(obligation.remaining))}.
              </Banner>
            )}
          </div>
        </section>
      )}

      <!-- Approval history -->
      <section class="card">
        <div class="card-header"><h2 class="card-title">Approval history</h2></div>
        <ol class="card-body space-y-4">
          {approvalHistory.map(w => (
            <li class="flex items-start gap-3">
              <span class={`mt-0.5 flex items-center justify-center w-7 h-7 rounded-full shrink-0 ${
                w.status === 'approved' ? 'badge-success'
                  : w.status === 'rejected' ? 'badge-danger'
                    : 'badge-secondary'
              }`} aria-hidden="true">
                <i class={`pi ${w.status === 'approved' ? 'pi-check' : w.status === 'rejected' ? 'pi-times' : w.status === 'skipped' ? 'pi-minus' : 'pi-clock'} text-xs`}></i>
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="font-medium text-gray-800">{STAGE_LABELS[w.stage] ?? w.stage} approval</p>
                  <Lozenge status={w.status === 'pending' && currentStage?.id === w.id && !rejected ? 'in_progress' : w.status} label={w.status === 'pending' && currentStage?.id === w.id && !rejected ? 'Current' : undefined} />
                </div>
                {(w.status === 'approved' || w.status === 'rejected') && (
                  <p class="text-sm text-gray-600">
                    {approverName(w) || 'Approver'}{w.approverPosition ? `, ${w.approverPosition}` : ''} · {formatDateTime(w.actionDate)}
                  </p>
                )}
                {w.comments && (
                  <p class="mt-2 p-3 rounded bg-gray-50 text-sm text-gray-700 whitespace-pre-wrap">{w.comments}</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Payment -->
      {(dv.status === 'approved' || dv.status === 'paid') && (
        <section class="card">
          <div class="card-header"><h2 class="card-title">Payment</h2></div>
          <div class="card-body">
            {!payment ? (
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-gray-700">This voucher is approved and ready for payment.</p>
                <a href={`/payments/create?dvId=${dv.id}`} class="btn btn-primary">Create payment</a>
              </div>
            ) : (
              <dl class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div>
                  <dt class="form-label">Type</dt>
                  <dd class="capitalize">{payment.paymentType.replace(/_/g, ' ')}</dd>
                </div>
                <div>
                  <dt class="form-label">Status</dt>
                  <dd><Lozenge status={payment.status} /></dd>
                </div>
                {payment.checkNo && (
                  <div>
                    <dt class="form-label">Check no.</dt>
                    <dd class="font-semibold">{payment.checkNo}</dd>
                  </div>
                )}
                {payment.receivedBy && (
                  <div>
                    <dt class="form-label">Received by</dt>
                    <dd>{payment.receivedBy} · {formatDate(payment.receivedDate)}</dd>
                  </div>
                )}
                {payment.orNo && (
                  <div>
                    <dt class="form-label">Official receipt</dt>
                    <dd>{payment.orNo}</dd>
                  </div>
                )}
                {payment.clearedDate && (
                  <div>
                    <dt class="form-label">Cleared</dt>
                    <dd>{formatDate(payment.clearedDate)}</dd>
                  </div>
                )}
              </dl>
            )}
          </div>
        </section>
      )}
    </div>

    <!-- Side column -->
    <aside class="space-y-6 min-w-0">
      {isOpen && currentStage && (
        <section class="card" aria-labelledby="decision-heading">
          <div class="card-header">
            <h2 id="decision-heading" class="card-title">Your decision</h2>
            <span class="badge">{STAGE_LABELS[currentStage.stage]}</span>
          </div>
          <div class="card-body">
            {canAct ? (
              <>
                <p class="text-sm text-gray-700 mb-4">
                  This voucher is at <strong>{STAGE_LABELS[currentStage.stage].toLowerCase()}</strong> approval and waiting for you.
                </p>
                <div class="flex flex-col gap-2">
                  <button type="button" class="btn btn-primary w-full" data-open="approve-dialog">
                    <i class="pi pi-check" aria-hidden="true"></i>
                    Approve
                  </button>
                  <button type="button" class="btn btn-secondary w-full" data-open="reject-dialog">
                    Reject
                  </button>
                </div>
              </>
            ) : blocked ? (
              <p class="text-sm text-gray-700">
                <strong>{blocked.blockedReason}</strong>, so segregation of duties requires another officer to approve this stage.
              </p>
            ) : (
              <p class="text-sm text-gray-700">
                Waiting for a {STAGE_LABELS[currentStage.stage].toLowerCase()} approver. You'll be able to act here if it reaches a stage you approve.
              </p>
            )}
          </div>
        </section>
      )}

      <section class="card">
        <div class="card-header"><h2 class="card-title">Details</h2></div>
        <dl class="card-body space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-gray-600">Created</dt>
            <dd class="text-right">{formatDateTime(dv.createdAt)}</dd>
          </div>
          {dv.updatedAt && (
            <div class="flex justify-between gap-4">
              <dt class="text-gray-600">Updated</dt>
              <dd class="text-right">{formatDateTime(dv.updatedAt)}</dd>
            </div>
          )}
          {dv.jevNo && (
            <div class="flex justify-between gap-4">
              <dt class="text-gray-600">JEV no.</dt>
              <dd class="text-right">{dv.jevNo}</dd>
            </div>
          )}
        </dl>
      </section>
    </aside>
  </div>

  {canAct && (
    <>
      <Modal id="approve-dialog" title={`Approve ${dv.dvNo}?`}>
        <form id="approve-form" class="space-y-3" method="dialog">
          <p class="text-sm text-gray-700">
            {peso(dv.amount)} to {dv.payeeName}. It will move to
            {currentStage?.stage === 'director' ? ' payment.' : ' the next approval stage.'}
          </p>
          <div>
            <label for="approve-comments" class="form-label">Comments (optional)</label>
            <textarea id="approve-comments" name="comments" rows="3" class="form-textarea"></textarea>
          </div>
          <p id="approve-error" class="form-error hidden" role="alert"></p>
        </form>
        <Fragment slot="footer">
          <button type="button" class="btn btn-subtle" data-modal-close>Cancel</button>
          <button type="submit" form="approve-form" class="btn btn-primary" id="approve-submit">Approve</button>
        </Fragment>
      </Modal>

      <Modal id="reject-dialog" title={`Reject ${dv.dvNo}?`} appearance="danger">
        <form id="reject-form" class="space-y-3" method="dialog">
          <p class="text-sm text-gray-700">Rejecting stops the voucher. The preparer will need to create a new one.</p>
          <div>
            <label for="reject-comments" class="form-label form-label-required">Reason</label>
            <textarea id="reject-comments" name="comments" rows="3" class="form-textarea" required></textarea>
            <p class="form-help">Say what needs to change so the preparer can fix it.</p>
          </div>
          <p id="reject-error" class="form-error hidden" role="alert"></p>
        </form>
        <Fragment slot="footer">
          <button type="button" class="btn btn-subtle" data-modal-close>Cancel</button>
          <button type="submit" form="reject-form" class="btn btn-danger" id="reject-submit">Reject voucher</button>
        </Fragment>
      </Modal>
    </>
  )}

  <script define:vars={{ dvId }}>
    document.querySelectorAll('[data-open]').forEach(button => {
      button.addEventListener('click', () => document.getElementById(button.dataset.open)?.showModal());
    });

    function wire(kind, label) {
      const form = document.getElementById(`${kind}-form`);
      const submit = document.getElementById(`${kind}-submit`);
      const error = document.getElementById(`${kind}-error`);
      if (!form || !submit) return;

      form.addEventListener('submit', async event => {
        event.preventDefault();
        const comments = form.elements.comments.value.trim();
        if (kind === 'reject' && !comments) {
          error.textContent = 'Enter a reason for rejecting.';
          error.classList.remove('hidden');
          return;
        }

        submit.disabled = true;
        submit.textContent = kind === 'approve' ? 'Approving…' : 'Rejecting…';
        error.classList.add('hidden');

        try {
          const response = await fetch(`/api/disbursements/${dvId}/${kind}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comments: comments || undefined }),
          });
          const result = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error(result.message || `Could not ${kind} this voucher.`);
          }

          const params = new URLSearchParams({ outcome: kind === 'approve' ? 'approved' : 'rejected' });
          if (result.nextInQueue) {
            params.set('next', result.nextInQueue.id);
            params.set('nextNo', result.nextInQueue.dvNo);
            params.set('remaining', result.remainingInQueue);
          }
          window.location.href = `/disbursements/${dvId}?${params}`;
        } catch (e) {
          error.textContent = e.message;
          error.classList.remove('hidden');
          submit.disabled = false;
          submit.textContent = label;
        }
      });
    }

    wire('approve', 'Approve');
    wire('reject', 'Reject voucher');
  </script>
</MainLayout>
