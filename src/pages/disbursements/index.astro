---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import DataTable from '../../components/ui/DataTable.astro';
import StatTile from '../../components/ui/StatTile.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Lozenge from '../../components/ui/Lozenge.astro';
import { disbursementService } from '../../lib/services/disbursement.service';
import { statusLabel } from '../../lib/ui/status';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const currentYear = new Date().getFullYear();

// Filters. Fiscal year defaults to the current year; "all" shows every year.
const status = Astro.url.searchParams.get('status') || undefined;
const yearParam = Astro.url.searchParams.get('fiscalYear');
const fiscalYear = yearParam === 'all' ? undefined : yearParam ? parseInt(yearParam) || currentYear : currentYear;
const search = Astro.url.searchParams.get('search')?.trim() || undefined;

const [dvs, stats] = await Promise.all([
  disbursementService.getDVs({ status, fiscalYear, search }),
  disbursementService.getDVStatistics(fiscalYear),
]);

const yearOptions = Array.from({ length: 6 }, (_, i) => currentYear + 1 - i);
const STATUSES = ['draft', 'pending_budget', 'pending_accounting', 'pending_director', 'approved', 'paid', 'rejected', 'cancelled'];
const activeFilters = [status, search, yearParam && yearParam !== String(currentYear) ? yearParam : undefined].filter(Boolean).length;

// Summary by stage of the journey, not raw status
const totalFor = (statuses: string[]) => {
  const rows = stats.filter(s => statuses.includes(s.status ?? ''));
  return {
    count: rows.reduce((sum, s) => sum + Number(s.count || 0), 0),
    amount: rows.reduce((sum, s) => sum + Number(s.totalAmount || 0), 0),
  };
};
const inApproval = totalFor(['draft', 'pending_budget', 'pending_accounting', 'pending_director']);
const readyToPay = totalFor(['approved']);
const paid = totalFor(['paid']);
const stopped = totalFor(['rejected', 'cancelled']);

const peso = (value: number | string) =>
  `₱${parseFloat(String(value || 0)).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

const formatDate = (date: Date | string | null) =>
  date ? new Date(date).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';

const yearLabel = fiscalYear ? `FY ${fiscalYear}` : 'all years';
const filterHref = (params: Record<string, string>) => `/disbursements?${new URLSearchParams({ fiscalYear: String(fiscalYear ?? 'all'), ...params })}`;
---

<MainLayout title="Disbursement vouchers - Philippine Government FMS">
  <PageHeader
    title="Disbursement vouchers"
    description={`Prepare, track and pay vouchers · ${yearLabel}`}
    breadcrumbs={[{ label: 'Home', href: '/dashboard' }, { label: 'Disbursement vouchers' }]}
  >
    <Fragment slot="actions">
      <a href="/approvals" class="btn btn-secondary">
        <i class="pi pi-inbox" aria-hidden="true"></i>
        My approvals
      </a>
      <a href="/disbursements/create" class="btn btn-primary">
        <i class="pi pi-plus" aria-hidden="true"></i>
        New voucher
      </a>
    </Fragment>
  </PageHeader>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <StatTile label="In approval" value={inApproval.count} help={peso(inApproval.amount)} icon="pi-clock" />
    <StatTile label="Ready to pay" value={readyToPay.count} help={peso(readyToPay.amount)} icon="pi-check-circle" href={filterHref({ status: 'approved' })} />
    <StatTile label="Paid" value={paid.count} help={peso(paid.amount)} icon="pi-wallet" href={filterHref({ status: 'paid' })} />
    <StatTile label="Rejected or cancelled" value={stopped.count} help={peso(stopped.amount)} icon="pi-times-circle" href={filterHref({ status: 'rejected' })} />
  </div>

  <FilterBar action="/disbursements" resetHref="/disbursements" activeCount={activeFilters}>
    <div class="form-group flex-1 min-w-[16rem]">
      <label for="search" class="form-label">Search</label>
      <input type="search" name="search" id="search" class="form-input" placeholder="DV no., payee, particulars or ORS/BURS no." value={search ?? ''} />
    </div>
    <div class="form-group">
      <label for="fiscalYear" class="form-label">Fiscal year</label>
      <select name="fiscalYear" id="fiscalYear" class="form-select">
        {yearOptions.map(year => <option value={year} selected={fiscalYear === year}>{year}</option>)}
        <option value="all" selected={!fiscalYear}>All years</option>
      </select>
    </div>
    <div class="form-group">
      <label for="status" class="form-label">Status</label>
      <select name="status" id="status" class="form-select">
        <option value="">Any status</option>
        {STATUSES.map(s => <option value={s} selected={status === s}>{statusLabel(s)}</option>)}
      </select>
    </div>
  </FilterBar>

  {dvs.length === 0 ? (
    <div class="card">
      <EmptyState
        icon="pi-file-edit"
        title={activeFilters ? 'No vouchers match these filters' : `No vouchers for ${yearLabel} yet`}
        description={activeFilters ? 'Try a different search or clear the filters.' : 'Vouchers you and your colleagues prepare will appear here.'}
      >
        {activeFilters ? (
          <a href="/disbursements" class="btn btn-secondary">Clear filters</a>
        ) : (
          <a href="/disbursements/create" class="btn btn-primary">Create a voucher</a>
        )}
      </EmptyState>
    </div>
  ) : (
    <DataTable title="Vouchers" count={dvs.length} quickFilter quickFilterLabel="Filter these results">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">DV no.</th>
            <th scope="col">Date</th>
            <th scope="col">Payee</th>
            <th scope="col" class="hidden xl:table-cell">Particulars</th>
            <th scope="col" class="hidden md:table-cell">Fund</th>
            <th scope="col" class="!text-right">Amount</th>
            <th scope="col">Status</th>
            <th scope="col" data-nosort><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {dvs.map(dv => (
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap">
                <a href={`/disbursements/${dv.id}`} class="font-medium text-primary-600 hover:underline">{dv.dvNo}</a>
              </td>
              <td class="whitespace-nowrap text-gray-600" data-sort-value={dv.dvDate ? new Date(dv.dvDate).getTime() : 0}>{formatDate(dv.dvDate)}</td>
              <td class="max-w-[14rem]"><p class="truncate" title={dv.payeeName}>{dv.payeeName}</p></td>
              <td class="hidden xl:table-cell max-w-[20rem]"><p class="truncate text-gray-600" title={dv.particulars}>{dv.particulars}</p></td>
              <td class="hidden md:table-cell text-gray-600">{dv.fundCluster?.code ?? '—'}</td>
              <td class="text-right font-medium tabular-nums whitespace-nowrap" data-sort-value={dv.amount}>{peso(dv.amount)}</td>
              <td class="whitespace-nowrap"><Lozenge status={dv.status} /></td>
              <td class="text-right whitespace-nowrap">
                {(dv.status === 'approved' || dv.status === 'paid') && (
                  <>
                    <a href={`/disbursements/${dv.id}/print`} target="_blank" class="btn btn-subtle btn-sm btn-icon" aria-label={`Print ${dv.dvNo}`} title="Print">
                      <i class="pi pi-print" aria-hidden="true"></i>
                    </a>
                    <a href={`/api/disbursements/${dv.id}/excel`} class="btn btn-subtle btn-sm btn-icon" aria-label={`Download ${dv.dvNo} as Excel`} title="Excel">
                      <i class="pi pi-file-excel" aria-hidden="true"></i>
                    </a>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </DataTable>
  )}
</MainLayout>
