---
import MainLayout from '../../layouts/MainLayout.astro';
import { db } from '../../lib/db/connection';
import { fundClusters, objectOfExpenditure, mfoPap } from '../../lib/db/schema';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

// Get current fiscal year
const currentYear = new Date().getFullYear();

// Get fund clusters
const fundClustersList = await db.select().from(fundClusters);

// Get object of expenditure
const objectOfExpenditureList = await db.select().from(objectOfExpenditure);

// Get MFO/PAP
const mfoPapList = await db.select().from(mfoPap);

// Prefill, e.g. when coming from "Create voucher from this obligation"
const params = Astro.url.searchParams;
const prefill = {
  fromObligation: parseInt(params.get('fromObligation') ?? '') || null,
  orsBursNo: params.get('orsBursNo') ?? '',
  payeeName: params.get('payeeName') ?? '',
  particulars: params.get('particulars') ?? '',
  amount: params.get('amount') ?? '',
  fundClusterId: parseInt(params.get('fundClusterId') ?? '') || null,
  objectExpenditureId: parseInt(params.get('objectExpenditureId') ?? '') || null,
};
---

<MainLayout title="Create Disbursement Voucher">
  <div class="container-fluid py-6">
    <!-- Page Header -->
    <div class="page-header">
      <div class="flex items-center gap-4 mb-2">
        <a href="/disbursements" class="text-gray-600 hover:text-gray-900" aria-label="Back">
          <i class="pi pi-arrow-left" aria-hidden="true"></i>
        </a>
        <h1 class="page-title">Create Disbursement Voucher</h1>
      </div>
      <p class="page-description">Create a new disbursement voucher for payment processing</p>
    </div>

    {prefill.fromObligation && (
      <div class="alert alert-info mb-4 max-w-5xl" role="status">
        <i class="pi pi-info-circle" aria-hidden="true"></i>
        <span>
          Filled in from obligation <a href={`/budget/obligations/${prefill.fromObligation}`} class="font-medium text-primary-600 hover:underline">{prefill.orsBursNo}</a>.
          Check the details, then add the payment mode.
        </span>
      </div>
    )}

    <div id="form-error" class="alert alert-error mb-4 max-w-5xl hidden" role="alert">
      <i class="pi pi-times-circle" aria-hidden="true"></i>
      <span id="form-error-text"></span>
    </div>

    <!-- DV Form -->
    <div class="card max-w-5xl">
      <div class="card-body">
        <form id="dv-form" method="POST" action="/api/disbursements">
          <div class="space-y-8">
            <!-- Basic Information -->
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">
                Basic Information
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Fund Cluster -->
                <div class="form-group">
                  <label for="fundClusterId" class="form-label form-label-required">Fund Cluster</label>
                  <select name="fundClusterId" id="fundClusterId" class="form-select" required>
                    <option value="">Select Fund Cluster</option>
                    {fundClustersList.map(fc => (
                      <option value={fc.id} selected={fc.id === prefill.fundClusterId}>{fc.code} - {fc.name}</option>
                    ))}
                  </select>
                  <p class="form-help">Select the fund cluster for this disbursement</p>
                </div>

                <!-- ORS/BURS Number -->
                <div class="form-group">
                  <label for="orsBursNo" class="form-label form-label-required">ORS/BURS Number</label>
                  <input
                    type="text"
                    name="orsBursNo"
                    id="orsBursNo"
                    class="form-input"
                    placeholder="e.g., 2024-001-0123"
                    value={prefill.orsBursNo}
                    required
                  />
                  <p class="form-help">Obligation Request and Status / Budget Utilization Request and Status</p>
                  <div id="ors-check" class="hidden mt-2 p-3 rounded bg-gray-50 text-sm" aria-live="polite"></div>
                </div>

                <!-- Fiscal Year -->
                <div class="form-group">
                  <label for="fiscalYear" class="form-label form-label-required">Fiscal Year</label>
                  <input
                    type="number"
                    name="fiscalYear"
                    id="fiscalYear"
                    class="form-input"
                    value={currentYear}
                    min="2020"
                    max="2099"
                    required
                  />
                </div>

                <!-- Payment Mode -->
                <div class="form-group">
                  <label for="paymentMode" class="form-label form-label-required">Payment Mode</label>
                  <select name="paymentMode" id="paymentMode" class="form-select" required>
                    <option value="">Select Payment Mode</option>
                    <option value="mds_check">MDS Check</option>
                    <option value="commercial_check">Commercial Check</option>
                    <option value="ada">ADA (Advice to Debit Account)</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Payee Information -->
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">
                Payee Information
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Payee Name -->
                <div class="form-group md:col-span-2">
                  <label for="payeeName" class="form-label form-label-required">Payee Name</label>
                  <input
                    type="text"
                    name="payeeName"
                    id="payeeName"
                    class="form-input"
                    placeholder="Enter full name or entity name"
                    value={prefill.payeeName}
                    list="payee-suggestions"
                    autocomplete="off"
                    required
                  />
                  <datalist id="payee-suggestions"></datalist>
                  <div id="payee-history" class="hidden mt-2 p-3 rounded bg-gray-50 text-sm"></div>
                </div>

                <!-- TIN -->
                <div class="form-group">
                  <label for="payeeTin" class="form-label">TIN (Tax Identification Number)</label>
                  <input
                    type="text"
                    name="payeeTin"
                    id="payeeTin"
                    class="form-input"
                    placeholder="000-000-000-000"
                  />
                </div>

                <!-- Address -->
                <div class="form-group">
                  <label for="payeeAddress" class="form-label">Address</label>
                  <input
                    type="text"
                    name="payeeAddress"
                    id="payeeAddress"
                    class="form-input"
                    placeholder="Enter payee address"
                  />
                </div>
              </div>
            </div>

            <!-- Transaction Details -->
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">
                Transaction Details
              </h3>
              <div class="grid grid-cols-1 gap-6">
                <!-- Particulars -->
                <div class="form-group">
                  <label for="particulars" class="form-label form-label-required">Particulars</label>
                  <textarea
                    name="particulars"
                    id="particulars"
                    rows="4"
                    class="form-textarea"
                    placeholder="Describe the purpose and details of this disbursement..."
                    required
                  >{prefill.particulars}</textarea>
                  <p class="form-help">Provide detailed description of the transaction</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Responsibility Center -->
                  <div class="form-group">
                    <label for="responsibilityCenter" class="form-label">Responsibility Center</label>
                    <input
                      type="text"
                      name="responsibilityCenter"
                      id="responsibilityCenter"
                      class="form-input"
                      placeholder="e.g., Office of the Regional Director"
                    />
                  </div>

                  <!-- MFO/PAP -->
                  <div class="form-group">
                    <label for="mfoPapId" class="form-label">MFO/PAP</label>
                    <select name="mfoPapId" id="mfoPapId" class="form-select">
                      <option value="">Select MFO/PAP (Optional)</option>
                      {mfoPapList.map(mfo => (
                        <option value={mfo.id}>{mfo.code} - {mfo.description}</option>
                      ))}
                    </select>
                    <p class="form-help">Major Final Output / Program, Activity, Project</p>
                  </div>

                  <!-- Object of Expenditure -->
                  <div class="form-group">
                    <label for="objectExpenditureId" class="form-label form-label-required">Object of Expenditure (UACS)</label>
                    <select name="objectExpenditureId" id="objectExpenditureId" class="form-select" required>
                      <option value="">Select Object of Expenditure</option>
                      {['Personnel Services', 'MOOE', 'Capital Outlay', 'Financial Assistance'].map(category => {
                        const items = objectOfExpenditureList.filter(obj => obj.category === category);
                        return items.length > 0 ? (
                          <optgroup label={category}>
                            {items.map(obj => (
                              <option value={obj.id} selected={obj.id === prefill.objectExpenditureId}>
                                {obj.code} - {obj.name}
                              </option>
                            ))}
                          </optgroup>
                        ) : null;
                      })}
                    </select>
                  </div>

                  <!-- Amount -->
                  <div class="form-group">
                    <label for="amount" class="form-label form-label-required">Amount</label>
                    <div class="relative">
                      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">₱</span>
                      <input
                        type="number"
                        name="amount"
                        id="amount"
                        class="form-input pl-8"
                        step="0.01"
                        min="0"
                        placeholder="0.00"
                        value={prefill.amount}
                        required
                      />
                    </div>
                    <p class="form-help" id="amount-words"></p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Possible duplicate payment -->
          <div id="duplicate-check" class="hidden mt-8 alert alert-warning" role="alert">
            <i class="pi pi-exclamation-triangle" aria-hidden="true"></i>
            <div class="min-w-0 flex-1">
              <p class="font-semibold">This might be a duplicate payment</p>
              <p class="mt-0.5">These live vouchers have the same amount and the same payee or ORS/BURS number:</p>
              <ul id="duplicate-list" class="mt-2 space-y-1"></ul>
              <label class="mt-3 flex items-start gap-2 font-medium">
                <input type="checkbox" id="duplicate-ack" class="mt-0.5" />
                <span>I've checked these and this is a separate payment. <span class="font-normal text-gray-700">(This confirmation is recorded in the audit log.)</span></span>
              </label>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="divider"></div>
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-600">
              <i class="pi pi-info-circle mr-1"></i>
              DV number will be auto-generated upon creation
            </div>
            <div class="flex gap-3">
              <a href="/disbursements" class="btn btn-secondary btn-md">
                Cancel
              </a>
              <button type="submit" class="btn btn-primary btn-md" id="submit-btn">
                <i class="pi pi-check mr-2"></i>
                Create Disbursement Voucher
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('dv-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const amountInput = document.getElementById('amount') as HTMLInputElement;
    const amountWords = document.getElementById('amount-words') as HTMLParagraphElement;

    // Convert number to words (Philippine Peso)
    function numberToWords(num: number): string {
      if (num === 0) return 'Zero Pesos';

      const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
      const teens = ['Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
      const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

      function convertLessThanThousand(n: number): string {
        if (n === 0) return '';

        if (n < 10) return ones[n];
        if (n < 20) return teens[n - 10];
        if (n < 100) return tens[Math.floor(n / 10)] + (n % 10 !== 0 ? ' ' + ones[n % 10] : '');

        return ones[Math.floor(n / 100)] + ' Hundred' + (n % 100 !== 0 ? ' ' + convertLessThanThousand(n % 100) : '');
      }

      let pesos = Math.floor(num);
      const centavos = Math.round((num - pesos) * 100);

      let result = '';

      if (pesos >= 1000000) {
        result += convertLessThanThousand(Math.floor(pesos / 1000000)) + ' Million ';
        pesos %= 1000000;
      }

      if (pesos >= 1000) {
        result += convertLessThanThousand(Math.floor(pesos / 1000)) + ' Thousand ';
        pesos %= 1000;
      }

      if (pesos > 0) {
        result += convertLessThanThousand(pesos);
      }

      result += ' Pesos';

      if (centavos > 0) {
        result += ' and ' + centavos + '/100';
      } else {
        result += ' Only';
      }

      return result.trim();
    }

    // Update amount in words
    amountInput?.addEventListener('input', () => {
      const amount = parseFloat(amountInput.value);
      if (!isNaN(amount) && amount > 0) {
        amountWords.textContent = numberToWords(amount);
        amountWords.classList.remove('form-help');
        amountWords.classList.add('text-sm', 'text-primary-600', 'font-medium', 'mt-1');
      } else {
        amountWords.textContent = '';
      }
    });

    // ---------- Pre-submit checks ----------
    const peso = (value: number) =>
      `₱${value.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const orsInput = document.getElementById('orsBursNo') as HTMLInputElement;
    const payeeInput = document.getElementById('payeeName') as HTMLInputElement;
    const orsCheck = document.getElementById('ors-check')!;
    const duplicateCheck = document.getElementById('duplicate-check')!;
    const duplicateList = document.getElementById('duplicate-list')!;
    const duplicateAck = document.getElementById('duplicate-ack') as HTMLInputElement;
    const formError = document.getElementById('form-error')!;
    const formErrorText = document.getElementById('form-error-text')!;

    interface Duplicate {
      id: number;
      dvNo: string;
      payeeName: string;
      amount: number;
      status: string;
      reason: string;
    }

    let duplicates: Duplicate[] = [];
    let checkTimer: number | undefined;

    function showError(message: string) {
      formErrorText.textContent = message;
      formError.classList.remove('hidden');
      formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function renderDuplicates(list: Duplicate[]) {
      // Keep the acknowledgement only if the matches haven't changed
      const sameMatches = duplicates.map(d => d.dvNo).join() === list.map(d => d.dvNo).join();
      duplicateAck.checked = sameMatches && duplicateAck.checked;
      duplicates = list;
      duplicateCheck.classList.toggle('hidden', list.length === 0);
      duplicateList.innerHTML = list
        .map(d => `<li><a href="/disbursements/${d.id}" target="_blank" rel="noopener" class="font-medium text-primary-600 hover:underline">${escapeHtml(d.dvNo)}</a>
          · ${escapeHtml(d.payeeName)} · ${peso(d.amount)} · <span class="badge">${escapeHtml(String(d.status).replace(/_/g, ' '))}</span>
          <span class="text-gray-700">(${escapeHtml(d.reason)})</span></li>`)
        .join('');
    }

    interface ObligationCheck {
      id: number;
      amount: number;
      committed: number;
      remaining: number;
      status: string;
      voucherCount: number;
    }

    function renderObligation(obligation: ObligationCheck | null) {
      if (!orsInput.value.trim()) {
        orsCheck.classList.add('hidden');
        return;
      }
      orsCheck.classList.remove('hidden');
      if (!obligation) {
        orsCheck.innerHTML = '<i class="pi pi-info-circle text-gray-500 mr-1" aria-hidden="true"></i>No obligation with this ORS/BURS number is in the registry. Check the number, or record the obligation first.';
        return;
      }
      const amount = parseFloat(amountInput.value) || 0;
      const after = obligation.remaining - amount;
      const over = amount > 0 && after < -0.004;
      orsCheck.innerHTML = `
        <p class="font-medium"><a href="/budget/obligations/${obligation.id}" target="_blank" rel="noopener" class="text-primary-600 hover:underline">Obligation found</a>
          · <span class="badge">${escapeHtml(obligation.status)}</span></p>
        <p class="mt-1 text-gray-700">Obligated ${peso(obligation.amount)} · on ${obligation.voucherCount} voucher(s) ${peso(obligation.committed)} ·
          <strong>${peso(obligation.remaining)} remaining</strong></p>
        ${obligation.status !== 'approved' ? '<p class="mt-1 text-orange-700"><i class="pi pi-exclamation-triangle mr-1" aria-hidden="true"></i>This obligation is not approved yet.</p>' : ''}
        ${over ? `<p class="mt-1 text-red-700 font-medium"><i class="pi pi-exclamation-circle mr-1" aria-hidden="true"></i>This amount is ${peso(-after)} more than what is left on the obligation.</p>` : ''}`;
    }

    async function runChecks() {
      const params = new URLSearchParams({
        payee: payeeInput.value,
        amount: amountInput.value,
        ors: orsInput.value.trim(),
      });
      try {
        const response = await fetch(`/api/disbursements/checks?${params}`);
        if (!response.ok) return;
        const result = await response.json();
        renderDuplicates(result.duplicates ?? []);
        renderObligation(result.obligation ?? null);
      } catch {
        // Checks are advisory; the server re-checks duplicates on submit
      }
    }

    function scheduleChecks() {
      window.clearTimeout(checkTimer);
      checkTimer = window.setTimeout(runChecks, 400);
    }

    [orsInput, payeeInput, amountInput].forEach(el => el?.addEventListener('input', scheduleChecks));

    // ---------- Payee suggestions from earlier vouchers ----------
    interface PayeeSuggestion {
      payeeName: string;
      payeeTin: string | null;
      payeeAddress: string | null;
      particulars: string[];
    }

    const datalist = document.getElementById('payee-suggestions')!;
    const payeeHistory = document.getElementById('payee-history')!;
    let payees: PayeeSuggestion[] = [];
    let payeeTimer: number | undefined;

    function showPayeeHistory() {
      const match = payees.find(p => p.payeeName.toLowerCase() === payeeInput.value.trim().toLowerCase());
      if (!match) {
        payeeHistory.classList.add('hidden');
        return;
      }
      payeeHistory.classList.remove('hidden');
      const fillDetails = match.payeeTin || match.payeeAddress
        ? '<button type="button" class="btn btn-secondary btn-xs mt-2" data-fill-payee>Use last TIN and address</button>'
        : '';
      const pastParticulars = match.particulars.length
        ? `<p class="mt-2 text-xs font-semibold text-gray-600">Reuse earlier particulars</p>
          <div class="mt-1 flex flex-col items-start gap-1">${match.particulars
            .map((p, i) => `<button type="button" class="max-w-full text-left text-primary-600 hover:underline truncate" data-fill-particulars="${i}" title="${escapeHtml(p)}">${escapeHtml(p)}</button>`)
            .join('')}</div>`
        : '';
      payeeHistory.innerHTML = `<p class="font-medium">Paid before</p>${fillDetails}${pastParticulars}`;

      payeeHistory.querySelector('[data-fill-payee]')?.addEventListener('click', () => {
        (document.getElementById('payeeTin') as HTMLInputElement).value = match.payeeTin ?? '';
        (document.getElementById('payeeAddress') as HTMLInputElement).value = match.payeeAddress ?? '';
      });
      payeeHistory.querySelectorAll<HTMLElement>('[data-fill-particulars]').forEach(button =>
        button.addEventListener('click', () => {
          (document.getElementById('particulars') as HTMLTextAreaElement).value =
            match.particulars[Number(button.dataset.fillParticulars)];
        })
      );
    }

    payeeInput?.addEventListener('input', () => {
      window.clearTimeout(payeeTimer);
      payeeTimer = window.setTimeout(async () => {
        const q = payeeInput.value.trim();
        if (q.length < 2) return;
        try {
          const response = await fetch(`/api/disbursements/payees?q=${encodeURIComponent(q)}`);
          if (!response.ok) return;
          payees = (await response.json()).payees ?? [];
          datalist.innerHTML = payees.map(p => `<option value="${escapeHtml(p.payeeName)}"></option>`).join('');
          showPayeeHistory();
        } catch {
          // Suggestions are optional
        }
      }, 250);
    });
    payeeInput?.addEventListener('change', showPayeeHistory);

    // Prefilled forms (e.g. from an obligation) get their checks straight away
    if (orsInput.value || payeeInput.value) runChecks();
    if (amountInput.value) amountInput.dispatchEvent(new Event('input'));

    // ---------- Submit ----------
    const submitLabel = submitBtn.innerHTML;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.classList.add('hidden');

      if (duplicates.length > 0 && !duplicateAck.checked) {
        duplicateCheck.scrollIntoView({ behavior: 'smooth', block: 'center' });
        duplicateAck.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner spinner-sm" aria-hidden="true"></span> Creating…';

      try {
        const formData = new FormData(form);
        const data = {
          fundClusterId: parseInt(formData.get('fundClusterId') as string),
          orsBursNo: formData.get('orsBursNo') as string,
          fiscalYear: parseInt(formData.get('fiscalYear') as string),
          payeeName: formData.get('payeeName') as string,
          payeeTin: formData.get('payeeTin') as string || undefined,
          payeeAddress: formData.get('payeeAddress') as string || undefined,
          particulars: formData.get('particulars') as string,
          responsibilityCenter: formData.get('responsibilityCenter') as string || undefined,
          mfoPapId: formData.get('mfoPapId') ? parseInt(formData.get('mfoPapId') as string) : undefined,
          objectExpenditureId: parseInt(formData.get('objectExpenditureId') as string),
          amount: parseFloat(formData.get('amount') as string),
          paymentMode: formData.get('paymentMode') as string,
          duplicateWarningAcknowledged: duplicateAck.checked ? duplicates.map(d => d.dvNo) : undefined,
        };

        const response = await fetch('/api/disbursements', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          window.location.href = `/disbursements/${result.id}`;
          return;
        }

        if (response.status === 409 && result.code === 'POSSIBLE_DUPLICATE') {
          // The server found matches the form hadn't shown yet
          renderDuplicates(result.duplicates ?? []);
          duplicateAck.checked = false;
          duplicateCheck.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          showError(result.message || 'The voucher could not be created. Check the form and try again.');
        }
      } catch (error) {
        console.error('Error:', error);
        showError('Could not reach the server. Check your connection and try again.');
      }

      submitBtn.disabled = false;
      submitBtn.innerHTML = submitLabel;
    });
  </script>
</MainLayout>
